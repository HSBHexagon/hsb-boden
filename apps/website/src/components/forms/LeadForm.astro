---
import { loadOptions } from "../../lib/validation";
import { site } from "../../data/site";
import { getLeadFormCopy } from "../../data/leadFormCopy";
import { cookieTexts, type Lang } from "../../lib/i18n";

interface Props {
  repairRequest?: boolean;
  lang?: Lang;
}

const { repairRequest = false, lang = "de" } = Astro.props;
const t = getLeadFormCopy(lang);
// Online-Versand aktiv, wenn der serverseitige Lead-Endpoint im Build freigegeben ist.
const deliveryConfigured = site.hasLeadEndpoint;
---

<form id="lead-form" method="post" action="/api/lead" class="surface grid gap-4 p-5" data-delivery-configured={deliveryConfigured} data-repair-request={repairRequest ? "true" : undefined} data-error-loads={t.errorLoads} data-sending-label={t.sending} data-success-path={t.successPath} data-mail-copy={JSON.stringify({ subject: t.mailSubject, hello: t.mailHello, firstName: t.firstName, company: t.company, email: t.email, phone: t.phone, industry: t.industry, projectType: t.projectType, area: t.area, operation: t.operation, loads: t.loads, message: t.message, noSelection: t.noSelection })}>
  {!deliveryConfigured ? (
    <div class="rounded border border-hsb-red/30 bg-hsb-red/5 p-4 text-sm leading-6 text-hsb-black">
      <p class="font-black">{t.directTitle}</p>
      <p class="mt-1 text-hsb-steel">
        {t.directIntro}
      </p>
      <p class="mt-2 font-bold">
        <a class="text-hsb-red hover:underline" href={`tel:${site.phone.replace("(0)", "").replace(/[^+\d]/g, "")}`}>{site.phone}</a>
        <span class="mx-2 text-hsb-line">·</span>
        <a class="text-hsb-red hover:underline" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <p class="mt-2 text-xs text-hsb-steel">
        {t.fallbackHint}
      </p>
    </div>
  ) : null}

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="grid gap-2 text-sm font-bold">
      <span>{t.firstName} <span class="text-hsb-red" aria-hidden="true">*</span></span>
      <input required minlength={2} maxlength={80} name="firstName" autocomplete="given-name" class="rounded border border-hsb-line px-3 py-3 font-normal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hsb-red" />
    </label>
    <label class="grid gap-2 text-sm font-bold">
      <span>{t.lastName} <span class="text-hsb-red" aria-hidden="true">*</span></span>
      <input required minlength={2} maxlength={80} name="lastName" autocomplete="family-name" class="rounded border border-hsb-line px-3 py-3 font-normal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hsb-red" />
    </label>
  </div>
  <label class="grid gap-2 text-sm font-bold">
    <span>{t.company} <span class="text-hsb-red" aria-hidden="true">*</span></span>
    <input required minlength={2} maxlength={120} name="company" autocomplete="organization" class="rounded border border-hsb-line px-3 py-3 font-normal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hsb-red" />
  </label>
  <div class="grid gap-4 sm:grid-cols-2">
    <label class="grid gap-2 text-sm font-bold">
      <span>{t.email} <span class="text-hsb-red" aria-hidden="true">*</span></span>
      <input required type="email" name="email" autocomplete="email" class="rounded border border-hsb-line px-3 py-3 font-normal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hsb-red" />
    </label>
    <label class="grid gap-2 text-sm font-bold">
      <span>{t.phone} <span class="text-hsb-red" aria-hidden="true">*</span></span>
      <input required minlength={5} type="tel" name="phone" autocomplete="tel" class="rounded border border-hsb-line px-3 py-3 font-normal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hsb-red" />
    </label>
  </div>
  <label class="grid gap-2 text-sm font-bold">
    <span>{t.projectType} <span class="text-hsb-red" aria-hidden="true">*</span></span>
    <select required name="projectType" class="rounded border border-hsb-line px-3 py-3 font-normal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hsb-red">
      <option value="">{t.choose}</option>
      <option value="neubau">{t.newBuild}</option>
      <option value="sanierung" selected={repairRequest}>{repairRequest ? t.repair : t.refurbishment}</option>
      <option value="bewertung">{t.assessment}</option>
    </select>
  </label>
  <fieldset id="loads-fieldset" class="grid gap-3">
    <legend class="text-sm font-black">{t.loads} <span class="text-hsb-red" aria-hidden="true">*</span> <span class="font-normal text-hsb-steel">{t.atLeastOne}</span></legend>
    <div class="grid gap-2 sm:grid-cols-2">
      {loadOptions.map((option) => (
        <label class="flex min-h-11 cursor-pointer items-center gap-3 rounded border border-hsb-line bg-white px-3 text-sm text-hsb-ink has-[:checked]:border-hsb-red has-[:checked]:bg-hsb-red/5">
          <input type="checkbox" name="loads" value={option} class="size-5 shrink-0 accent-hsb-red" />
          {t.loadLabels[option]}
        </label>
      ))}
    </div>
  </fieldset>
  <label class="grid gap-2 text-sm font-bold">
    <span>{t.message} <span class="text-hsb-red" aria-hidden="true">*</span></span>
    <textarea required minlength={10} maxlength={2000} name="message" rows={5} placeholder={repairRequest ? t.repairPlaceholder : undefined} class="rounded border border-hsb-line px-3 py-3 font-normal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hsb-red" />
  </label>
  <details id="lead-details" class="rounded border border-hsb-line bg-hsb-mist/60 open:bg-white">
    <summary class="flex min-h-12 cursor-pointer items-center justify-between gap-3 px-4 py-3 text-sm font-black text-hsb-black">
      <span>{t.details} <span class="font-normal text-hsb-steel">{t.optional}</span></span>
      <svg class="size-4 shrink-0 text-hsb-red transition-transform [details[open]_&]:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
    </summary>
    <div class="grid gap-4 border-t border-hsb-line p-4 sm:grid-cols-3">
      <label class="grid gap-2 text-sm font-bold">
        {t.industry}
        <select name="industry" class="rounded border border-hsb-line px-3 py-3 font-normal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hsb-red">
          <option value="">{t.noSelection}</option>
          <option value="lebensmittelindustrie">{t.food}</option>
          <option value="molkerei">{t.dairy}</option>
          <option value="brauerei-getraenkeindustrie">{t.brewery}</option>
          <option value="chemieindustrie">{t.chemical}</option>
          <option value="pharmaindustrie">{t.pharma}</option>
          <option value="backwarenproduktion-grosskueche">{t.bakery}</option>
          <option value="sonstige">{t.other}</option>
        </select>
      </label>
      <label class="grid gap-2 text-sm font-bold">
        {t.area}
        <input name="areaSize" inputmode="numeric" class="rounded border border-hsb-line px-3 py-3 font-normal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hsb-red" />
      </label>
      <label class="grid gap-2 text-sm font-bold">
        {t.operation}
        <select name="liveOperation" class="rounded border border-hsb-line px-3 py-3 font-normal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hsb-red">
          <option value="unklar" selected>{t.unsure}</option>
          <option value="ja">{t.yes}</option>
          <option value="nein">{t.no}</option>
        </select>
      </label>
    </div>
  </details>
  <label class="flex items-start gap-3 text-sm leading-6 text-hsb-steel">
    <input required type="checkbox" name="privacyConsent" class="mt-0.5 size-5 shrink-0 accent-hsb-red focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hsb-red" />
    <span>{t.privacy} <a class="underline underline-offset-2 hover:text-hsb-red" href="/datenschutz/" hreflang="de">{cookieTexts[lang].privacyLink}</a></span>
  </label>

  <p id="form-error" role="alert" aria-live="assertive" class="hidden rounded border border-hsb-red/40 bg-hsb-red/5 px-3 py-2 text-sm text-hsb-red">
    {t.errorPrefix}{" "}{site.phone}{" "}{t.or}{" "}{site.email}.
  </p>

  <noscript>
    <p class="rounded border border-hsb-line bg-hsb-mist p-4 text-sm leading-6 text-hsb-black">
      {t.noScript}{" "}
      <a class="font-bold underline" href={`tel:${site.phone.replace("(0)", "").replace(/[^+\d]/g, "")}`}>{site.phone}</a>{" "}
      {t.or}{" "}<a class="font-bold underline" href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
  </noscript>

  <button
    id="form-submit"
    class="button-primary"
    type="submit"
    disabled
  >
    {!deliveryConfigured
      ? t.composeEmail
      : t.send}
  </button>
</form>

<script>
  import { trackEvent, trackEventAndWait, TrackingEvent } from "../../lib/tracking";
  import { trackAfterConfirmedLead } from "../../lib/confirmedLeadTracking";
  import { buildLeadAttributionFields, captureAttribution, loadAttribution } from "../../lib/attribution";
  import {
    STRESS_CHECK_EVENT,
    clearStressCheckHandoff,
    loadStressCheckHandoff,
    type LeadPrefill,
  } from "../../lib/stressCheckHandoff";
  import { site } from "../../data/site";

  const form = document.getElementById("lead-form") as HTMLFormElement | null;
  const submitBtn = document.getElementById("form-submit") as HTMLButtonElement | null;
  if (submitBtn) submitBtn.disabled = false;
  const errorMsg = document.getElementById("form-error");
  const deliveryConfigured = form?.dataset.deliveryConfigured === "true";
  const genericErrorText = errorMsg?.textContent ?? "";

  let started = false;

  function onFocus() {
    if (!started) {
      started = true;
      trackEvent(TrackingEvent.LeadFormStart);
    }
  }

  async function onSubmit(event: SubmitEvent) {
    event.preventDefault();
    if (!form || !submitBtn || !errorMsg) return;

    const fd = new FormData(form);

    // Server-Schema verlangt mindestens eine Belastung (leadSchema: loads.min(1));
    // Checkbox-Gruppen haben kein natives required, daher hier prüfen.
    if (fd.getAll("loads").length === 0) {
      errorMsg.textContent =
        form.dataset.errorLoads || "Bitte wählen Sie mindestens eine Belastung aus, damit wir Ihr Projekt einschätzen können.";
      errorMsg.classList.remove("hidden");
      document.getElementById("loads-fieldset")?.querySelector("input")?.focus();
      return;
    }

    // Ehrlicher Mailto-Fallback, wenn Webhook-Endpunkt nicht aktiv/konfiguriert ist
    if (!deliveryConfigured) {
      const company = String(fd.get("company") || "Industrieboden");
      const mailCopy = JSON.parse(form.dataset.mailCopy || "{}") as Record<string, string>;
      const subject = encodeURIComponent(`${mailCopy.subject || "Projektanfrage Industrieboden"}: ${company}`);
      const bodyLines = [
        mailCopy.hello || "Guten Tag HSB-Team,",
        "",
        `${mailCopy.firstName || "Name"}: ${fd.get("firstName")} ${fd.get("lastName")}`,
        `${mailCopy.company || "Firma"}: ${company}`,
        `${mailCopy.email || "E-Mail"}: ${fd.get("email")}`,
        `${mailCopy.phone || "Telefon"}: ${fd.get("phone") || mailCopy.noSelection || "k. A."}`,
        `${mailCopy.industry || "Branche"}: ${fd.get("industry") || mailCopy.noSelection || "k. A."}`,
        `${mailCopy.projectType || "Projektart"}: ${fd.get("projectType")}`,
        `${mailCopy.area || "Fläche"}: ${fd.get("areaSize") || mailCopy.noSelection || "k. A."} m²`,
        `${mailCopy.operation || "Laufender Betrieb"}: ${fd.get("liveOperation")}`,
        `${mailCopy.loads || "Belastungen"}: ${fd.getAll("loads").join(", ")}`,
        "",
        `${mailCopy.message || "Nachricht"}:`,
        String(fd.get("message") || ""),
      ];
      window.location.href = `mailto:${site.email}?subject=${subject}&body=${encodeURIComponent(bodyLines.join("\n"))}`;
      return;
    }

    // Session-Attribution (UTM/Referrer/Landingpage) anreichern; Fallback auf
    // Frisch-Erfassung, falls sessionStorage blockiert ist. Darf nie werfen.
    let attributionFields: Record<string, string> = {};
    try {
      const attribution =
        loadAttribution(window.sessionStorage) ??
        captureAttribution({
          search: window.location.search,
          referrer: document.referrer,
          pathname: window.location.pathname,
          origin: window.location.origin,
        });
      attributionFields = buildLeadAttributionFields(attribution, window.location.pathname);
    } catch {
      attributionFields = {};
    }

    const payload: Record<string, unknown> = {
      ...attributionFields,
      source: "website",
      legalBasis: "inquiry",
      firstName: fd.get("firstName"),
      lastName: fd.get("lastName"),
      company: fd.get("company"),
      email: fd.get("email"),
      phone: fd.get("phone"),
      // Branche und Betrieb sind optional; der Endpunkt erwartet weiterhin beide Felder.
      industry: fd.get("industry") || "sonstige",
      projectType: fd.get("projectType"),
      areaSize: fd.get("areaSize") ?? "",
      liveOperation: fd.get("liveOperation") || "unklar",
      loads: fd.getAll("loads"),
      message: fd.get("message"),
      privacyConsent: fd.get("privacyConsent") === "on",
    };

    submitBtn.disabled = true;
    const originalBtnText = submitBtn.textContent;
    submitBtn.textContent = form.dataset.sendingLabel || "Wird gesendet …";
    errorMsg.classList.add("hidden");

    try {
      const res = await fetch("/api/lead", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error(`Status ${res.status}`);
    } catch (e) {
      console.error("Submission error:", e);
      submitBtn.disabled = false;
      submitBtn.textContent = originalBtnText;
      errorMsg.textContent = genericErrorText;
      errorMsg.classList.remove("hidden");
      return;
    }

    // Only an unsuccessful backend delivery may re-enable submission.
    await trackAfterConfirmedLead(() => trackEventAndWait(TrackingEvent.LeadFormSubmit));
    window.location.href = form.dataset.successPath || "/danke-projektanfrage/";
  }

  // Übergabe aus dem Beanspruchungs-Check: Belastungen, Projektart, Betrieb
  // und technische Nachricht vorbelegen. Personenfelder bleiben leer.
  let lastPrefillMessage = "";
  function applyPrefill(prefill: LeadPrefill) {
    if (!form) return;
    form.querySelectorAll<HTMLInputElement>('input[name="loads"]').forEach((box) => {
      box.checked = prefill.loads.includes(box.value);
    });
    const projectType = form.elements.namedItem("projectType");
    if (projectType instanceof HTMLSelectElement) projectType.value = prefill.projectType;
    const liveOperation = form.elements.namedItem("liveOperation");
    if (liveOperation instanceof HTMLSelectElement) liveOperation.value = prefill.liveOperation;
    const message = form.elements.namedItem("message");
    if (
      message instanceof HTMLTextAreaElement &&
      (message.value.trim() === "" || message.value === lastPrefillMessage)
    ) {
      message.value = prefill.message;
    }
    lastPrefillMessage = prefill.message;
    form.dataset.stressCheckSystem = prefill.recommendedSystem;
    // Vorbelegte Angaben sichtbar machen, statt sie im eingeklappten Bereich zu verstecken.
    const details = document.getElementById("lead-details");
    if (details instanceof HTMLDetailsElement) details.open = true;
  }

  function applyCalculatorQueryPrefill() {
    if (!form) return;
    try {
      const params = new URLSearchParams(window.location.search);
      const rawArea = params.get("areaSize");
      const rawSystem = params.get("system");
      const rawWindow = params.get("timeWindow");
      const rawSections = params.get("sections");

      if (!rawArea && !rawSystem && !rawWindow && !rawSections) return;

      const areaNum = rawArea ? parseInt(rawArea, 10) : NaN;
      const areaControl = form.elements.namedItem("areaSize");
      if (areaControl instanceof HTMLInputElement && Number.isFinite(areaNum) && areaNum >= 1 && areaNum <= 50000) {
        areaControl.value = `${areaNum} m²`;
        const details = document.getElementById("lead-details");
        if (details instanceof HTMLDetailsElement) details.open = true;
      }

      const projectTypeControl = form.elements.namedItem("projectType");
      if (projectTypeControl instanceof HTMLSelectElement && !projectTypeControl.value) {
        projectTypeControl.value = "sanierung";
      }

      const liveOpControl = form.elements.namedItem("liveOperation");
      if (liveOpControl instanceof HTMLSelectElement && rawWindow) {
        if (rawWindow === "laufender-betrieb" || rawWindow === "wochenende-60h") {
          liveOpControl.value = "ja";
        } else if (rawWindow === "betriebsurlaub") {
          liveOpControl.value = "nein";
        }
      }

      const systemLabels: Record<string, string> = {
        "pu-beton": "Hochtemperatur-PU-Beton (9 mm)",
        "ruettelkeramik": "Keramischer Rüttelboden (AGI S 40)",
        "schnellreparatur": "Schnellreparatur-Mörtel",
      };
      const windowLabels: Record<string, string> = {
        "wochenende-60h": "Wochenend-Stillstand (60 h)",
        "betriebsurlaub": "Geplanter Stillstand / Werksferien",
        "laufender-betrieb": "Laufender 3-Schicht-Betrieb",
      };

      const parts: string[] = [];
      if (Number.isFinite(areaNum) && areaNum >= 1 && areaNum <= 50000) parts.push(`Fläche: ca. ${areaNum} m²`);
      if (rawSystem && systemLabels[rawSystem]) parts.push(`System: ${systemLabels[rawSystem]}`);
      if (rawWindow && windowLabels[rawWindow]) parts.push(`Zeitfenster: ${windowLabels[rawWindow]}`);
      const secNum = rawSections ? parseInt(rawSections, 10) : NaN;
      if (Number.isFinite(secNum) && secNum >= 1 && secNum <= 200) parts.push(`Simulierte Abschnitte (MOCK_DATA): ${secNum}`);

      const messageControl = form.elements.namedItem("message");
      if (messageControl instanceof HTMLTextAreaElement && messageControl.value.trim() === "" && parts.length > 0) {
        messageControl.value = `Übernahme aus Sanierungsfenster-Rechner:\n- ${parts.join("\n- ")}\n\nBitte um Prüfung im Vor-Ort-Audit.`;
      }
    } catch {
      // Query-Parsing darf Formular nie blockieren
    }
  }

  if (form?.dataset.repairRequest !== "true") {
    window.addEventListener(STRESS_CHECK_EVENT, (event) => {
      const detail = (event as CustomEvent<LeadPrefill>).detail;
      if (detail) applyPrefill(detail);
    });

    try {
      const stored = loadStressCheckHandoff(window.sessionStorage);
      if (stored) {
        applyPrefill(stored);
        clearStressCheckHandoff(window.sessionStorage);
      }
    } catch {
      // sessionStorage blockiert: Formular bleibt unbefüllt nutzbar.
    }

    applyCalculatorQueryPrefill();
  }

  form?.addEventListener("focusin", onFocus, { once: true });
  form?.addEventListener("submit", onSubmit);
</script>
