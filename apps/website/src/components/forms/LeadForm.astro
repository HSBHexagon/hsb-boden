---
import { loadOptions } from "../../lib/validation";
import { site } from "../../data/site";

// Online-Versand nur aktiv, wenn der serverseitige Lead-Endpoint konfiguriert ist.
const deliveryConfigured = site.hasLeadEndpoint;
---

<form id="lead-form" class="surface grid gap-4 p-5" data-delivery-configured={deliveryConfigured}>
  {!deliveryConfigured ? (
    <div class="rounded border border-hsb-red/30 bg-hsb-red/5 p-4 text-sm leading-6 text-hsb-black">
      <p class="font-black">Direkter Draht ins Projektgeschäft</p>
      <p class="mt-1 text-hsb-steel">
        Für eine schnelle Ersteinschätzung erreichen Sie HSB direkt:
      </p>
      <p class="mt-2 font-bold">
        <a class="text-hsb-red hover:underline" href={`tel:${site.phone.replace("(0)", "").replace(/[^+\d]/g, "")}`}>{site.phone}</a>
        <span class="mx-2 text-hsb-line">·</span>
        <a class="text-hsb-red hover:underline" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  ) : null}

  {deliveryConfigured ? (
    <>
      <p class="text-sm leading-6 text-hsb-steel">Für den Erstkontakt reichen Name, Firma, E-Mail und eine kurze Beschreibung. Technische Details klären wir anschließend.</p>
      <label class="grid gap-2 text-sm font-bold"><span>Name <span aria-hidden="true">*</span></span>
        <input required minlength={2} maxlength={80} name="firstName" autocomplete="name" class="rounded border border-hsb-line px-3 py-3 font-normal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hsb-red" />
      </label>
      <label class="grid gap-2 text-sm font-bold"><span>Firma <span aria-hidden="true">*</span></span>
        <input required minlength={2} maxlength={120} name="company" autocomplete="organization" class="rounded border border-hsb-line px-3 py-3 font-normal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hsb-red" />
      </label>
      <label class="grid gap-2 text-sm font-bold"><span>E-Mail <span aria-hidden="true">*</span></span>
        <input required type="email" maxlength={254} name="email" autocomplete="email" class="rounded border border-hsb-line px-3 py-3 font-normal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hsb-red" />
      </label>
      <label class="grid gap-2 text-sm font-bold"><span>Projekt kurz beschreiben <span aria-hidden="true">*</span></span>
        <textarea required minlength={10} maxlength={2000} name="message" rows={4} class="rounded border border-hsb-line px-3 py-3 font-normal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hsb-red" />
      </label>
      <details class="rounded border border-hsb-line p-4">
        <summary class="cursor-pointer py-2 text-sm font-bold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hsb-red">Telefon und technische Angaben ergänzen (optional)</summary>
        <div class="mt-4 grid gap-4">
          <label class="grid gap-2 text-sm font-bold"><span>Telefon für Rückfragen (optional)</span>
            <input minlength={5} maxlength={64} type="tel" name="phone" autocomplete="tel" class="rounded border border-hsb-line px-3 py-3 font-normal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hsb-red" />
          </label>
  <div class="grid gap-4 sm:grid-cols-2">
    <label class="grid gap-2 text-sm font-bold">
      <span>Branche (optional)</span>
      <select name="industry" class="rounded border border-hsb-line px-3 py-3 font-normal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hsb-red">
        <option value="">Bitte wählen</option>
        <option value="lebensmittelindustrie">Lebensmittelindustrie</option>
        <option value="molkerei">Molkerei</option>
        <option value="brauerei-getraenkeindustrie">Brauerei/Getränke</option>
        <option value="chemieindustrie">Chemie</option>
        <option value="pharmaindustrie">Pharma</option>
        <option value="backwarenproduktion-grosskueche">Backwaren/Großküche</option>
        <option value="sonstige">Sonstige</option>
      </select>
    </label>
    <label class="grid gap-2 text-sm font-bold">
      <span>Projektart (optional)</span>
      <select name="projectType" class="rounded border border-hsb-line px-3 py-3 font-normal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hsb-red">
        <option value="">Bitte wählen</option>
        <option value="neubau">Neubau</option>
        <option value="sanierung">Sanierung</option>
        <option value="bewertung">Technische Bewertung</option>
      </select>
    </label>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <label class="grid gap-2 text-sm font-bold">
      Fläche in m² (optional)
      <input name="areaSize" class="rounded border border-hsb-line px-3 py-3 font-normal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hsb-red" />
    </label>
    <label class="grid gap-2 text-sm font-bold">
      <span>Laufender Betrieb (optional)</span>
      <select name="liveOperation" class="rounded border border-hsb-line px-3 py-3 font-normal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hsb-red">
        <option value="">Bitte wählen</option>
        <option value="ja">Ja</option>
        <option value="nein">Nein</option>
        <option value="unklar">Unklar</option>
      </select>
    </label>
  </div>
  <fieldset id="loads-fieldset" class="grid gap-3">
    <legend class="text-sm font-black">Belastungen <span class="font-normal text-hsb-steel">(optional)</span></legend>
    <div class="grid gap-2 sm:grid-cols-2">
      {loadOptions.map((option) => (
        <label class="flex items-center gap-2 text-sm text-hsb-steel">
          <input type="checkbox" name="loads" value={option} />
          {option}
        </label>
      ))}
    </div>
  </fieldset>

        </div>
      </details>
      <div class="hidden" aria-hidden="true"><input name="honeypot" tabindex="-1" autocomplete="off" /></div>
      <label class="flex items-start gap-3 text-sm leading-6 text-hsb-steel">
        <input required type="checkbox" name="privacyConsent" class="mt-1 size-5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hsb-red" />
        <span>Ich habe die <a href="/datenschutz/" class="underline">Datenschutzhinweise</a> zur Bearbeitung meiner Anfrage zur Kenntnis genommen.</span>
      </label>
      <p class="text-xs leading-5 text-hsb-steel">Mit * markierte Angaben sind erforderlich. Die Anfrage ist unabhängig von Ihrer Statistik-Auswahl.</p>
      <p id="form-error" role="alert" aria-live="assertive" tabindex="-1" class="hidden rounded border border-hsb-red/40 bg-hsb-red/5 px-3 py-2 text-sm text-hsb-red">
        Ihre Anfrage konnte nicht bestätigt werden. Ihre Eingaben bleiben erhalten. Bitte kontaktieren Sie uns unter {site.phone} oder {site.email}.
      </p>
      <button id="form-submit" class="button-primary disabled:cursor-not-allowed disabled:opacity-60" type="submit">Projektanfrage senden</button>
    </>
  ) : null}
</form>

<script>
  import { submitLeadInquiry } from "../../lib/leadSubmission";
  import { hasStoredAnalyticsConsent } from "../../lib/analytics";
  import { trackEvent, trackEventAndWait, TrackingEvent } from "../../lib/tracking";
  import { buildLeadAttributionFields, captureAttribution, loadAttribution } from "../../lib/attribution";
  import {
    STRESS_CHECK_EVENT,
    clearStressCheckHandoff,
    loadStressCheckHandoff,
    type LeadPrefill,
  } from "../../lib/stressCheckHandoff";

  const form = document.getElementById("lead-form") as HTMLFormElement | null;
  const submitBtn = document.getElementById("form-submit") as HTMLButtonElement | null;
  const errorMsg = document.getElementById("form-error");
  const deliveryConfigured = form?.dataset.deliveryConfigured === "true";
  const genericErrorText = errorMsg?.textContent ?? "";

  let started = false;
  let sending = false;
  let analyticsConsent = hasStoredAnalyticsConsent(window);
  window.addEventListener("hsb:consent", event => {
    analyticsConsent = (event as CustomEvent<{ analytics?: unknown }>).detail?.analytics === true;
  });

  function onFocus() {
    if (deliveryConfigured && !started) {
      started = true;
      trackEvent(TrackingEvent.LeadFormStart, { form_id: "lead-form", form_path: window.location.pathname });
    }
  }

  async function onSubmit(event: SubmitEvent) {
    event.preventDefault();
    if (!deliveryConfigured || sending || !form || !submitBtn || !errorMsg) return;

    const fd = new FormData(form);

    // Session-Attribution (UTM/Referrer/Landingpage) anreichern; Fallback auf
    // Frisch-Erfassung, falls sessionStorage blockiert ist. Darf nie werfen.
    let attributionFields: Record<string, string> = {};
    try {
      if (analyticsConsent) {
      const attribution =
        loadAttribution(window.sessionStorage) ??
        captureAttribution({
          search: window.location.search,
          referrer: document.referrer,
          pathname: window.location.pathname,
          origin: window.location.origin,
        });
      attributionFields = buildLeadAttributionFields(attribution, window.location.pathname);
      }
    } catch {
      attributionFields = {};
    }

    const payload: Record<string, unknown> = {
      ...attributionFields,
      source: "website",
      legalBasis: "inquiry",
      firstName: fd.get("firstName"),
      lastName: fd.get("lastName") ?? "",
      company: fd.get("company"),
      email: fd.get("email"),
      phone: fd.get("phone") ?? "",
      industry: fd.get("industry") ?? "",
      projectType: fd.get("projectType") || "bewertung",
      areaSize: fd.get("areaSize") ?? "",
      liveOperation: fd.get("liveOperation") || "unklar",
      loads: fd.getAll("loads"),
      message: fd.get("message"),
      privacyConsent: fd.get("privacyConsent") === "on",
      honeypot: fd.get("honeypot") ?? "",
    };

    sending = true;
    form.setAttribute("aria-busy", "true");
    submitBtn.disabled = true;
    const originalBtnText = submitBtn.textContent;
    submitBtn.textContent = "Wird gesendet …";
    errorMsg.classList.add("hidden");

    try {
      await submitLeadInquiry(payload);
      await trackEventAndWait(TrackingEvent.LeadFormSubmit, { form_id: "lead-form", form_path: window.location.pathname });
      window.location.href = "/danke-projektanfrage/";
    } catch (e) {
      console.error("Submission could not be confirmed.");
      submitBtn.disabled = false;
      submitBtn.textContent = originalBtnText;
      errorMsg.textContent = genericErrorText;
      errorMsg.classList.remove("hidden");
      errorMsg.focus();
    } finally {
      sending = false;
      form.removeAttribute("aria-busy");
    }
  }

  // Übergabe aus dem Beanspruchungs-Check: Belastungen, Projektart, Betrieb
  // und technische Nachricht vorbelegen. Personenfelder bleiben leer.
  let lastPrefillMessage = "";
  function applyPrefill(prefill: LeadPrefill) {
    if (!form) return;
    const details = form.querySelector("details");
    if (details) details.open = true;
    form.querySelectorAll<HTMLInputElement>('input[name="loads"]').forEach((box) => {
      box.checked = prefill.loads.includes(box.value);
    });
    const projectType = form.elements.namedItem("projectType");
    if (projectType instanceof HTMLSelectElement) projectType.value = prefill.projectType;
    const liveOperation = form.elements.namedItem("liveOperation");
    if (liveOperation instanceof HTMLSelectElement) liveOperation.value = prefill.liveOperation;
    const message = form.elements.namedItem("message");
    if (
      message instanceof HTMLTextAreaElement &&
      (message.value.trim() === "" || message.value === lastPrefillMessage)
    ) {
      message.value = prefill.message;
    }
    lastPrefillMessage = prefill.message;
    form.dataset.stressCheckSystem = prefill.recommendedSystem;
  }

  window.addEventListener(STRESS_CHECK_EVENT, (event) => {
    const detail = (event as CustomEvent<LeadPrefill>).detail;
    if (detail) applyPrefill(detail);
  });

  try {
    const stored = loadStressCheckHandoff(window.sessionStorage);
    if (stored) {
      applyPrefill(stored);
      clearStressCheckHandoff(window.sessionStorage);
    }
  } catch {
    // sessionStorage blockiert: Formular bleibt unbefüllt nutzbar.
  }

  form?.addEventListener("focusin", onFocus, { once: true });
  form?.addEventListener("submit", onSubmit);
</script>
