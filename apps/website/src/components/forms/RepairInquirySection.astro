---
import LeadForm from "./LeadForm.astro";
import RepairPhotoForm from "./RepairPhotoForm.astro";
import { site } from "../../data/site";
import { toTelephoneHref } from "../../lib/phone";

const phoneHref = toTelephoneHref(site.phone);
---

<section id="reparaturanfrage" class="section scroll-mt-24 border-t border-hsb-line bg-hsb-mist" aria-labelledby="repair-inquiry-title">
  <div class="container grid gap-8 lg:grid-cols-2 lg:items-start">
    <div class="order-2 lg:order-1">
      <p class="eyebrow">Technische Ersteinschätzung</p>
      <h2 id="repair-inquiry-title" class="h2 mt-3">Lässt sich die Schadstelle gezielt reparieren?</h2>
      <p class="lead mt-4">Beschreiben Sie kurz die Stelle und nennen Sie den Standort. Ein Foto und ein mögliches Sperrfenster helfen uns, den nächsten Prüfschritt einzugrenzen.</p>
      <p class="mt-4 font-semibold text-hsb-ink" data-repair-promise>Ersteinschätzung innerhalb eines Arbeitstags, kostenfrei.</p>
      <p class="mt-2 text-hsb-steel">
        {site.hasRepairPhotoUpload
          ? "Laden Sie das Foto direkt im Formular hoch. Kein Foto zur Hand? Fordern Sie einfach einen Rückruf oder Vor-Ort-Termin an."
          : "Fordern Sie über das Formular eine Einschätzung, einen Rückruf oder einen Termin an."}
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="button-secondary-dark" href={phoneHref} data-repair-contact="phone">{site.phone}</a>
      </div>
      <p class="mt-3 text-sm text-hsb-steel">Direkter Draht zu unseren Fachingenieuren für Industrieböden und Säureschutz.</p>
    </div>
    <div class="order-1 lg:order-2">
      {site.hasRepairPhotoUpload ? <RepairPhotoForm /> : site.hasLeadEndpoint && <LeadForm repairRequest />}
    </div>
  </div>
</section>

<script>
  import { trackEvent, TrackingEvent } from "../../lib/tracking";

  document.querySelectorAll<HTMLAnchorElement>("[data-repair-contact]").forEach((link) => {
    link.addEventListener("click", () => {
      const event = link.dataset.repairContact === "email" ? TrackingEvent.EmailClick : TrackingEvent.PhoneClick;
      trackEvent(event, { placement: "repair_inquiry" });
    });
  });
</script>
