---
import { navigation } from "../../data/navigation";
import { site } from "../../data/site";
import { languages, type Lang } from "../../lib/i18n";

interface Props {
  lang?: Lang;
}

const { lang = "de" } = Astro.props;
const phoneHref = site.phone.replace("(0)", "").replace(/[^\d+]/g, "");
---

<style>
  #header-scroll-sentinel {
    position: absolute;
    inset-block-start: 0;
    height: 1px;
    width: 1px;
    pointer-events: none;
  }
  #site-header {
    transition: background 200ms ease, border-color 200ms ease, box-shadow 200ms ease, color 200ms ease;
  }
  /* Durchgehend dunkler Header (industrieller Charakter).
     Oben: deckungsgleich mit dem dunklen Hero (#161a20) -> nahtloser Top-Fold.
     Auf hellen Unterseiten-Heros bleibt es eine klare dunkle Leiste. */
  #site-header {
    background: #161a20;
    color: #ffffff;
    border-bottom: 1px solid transparent;
  }
  #site-header .nav-links a {
    color: rgba(255, 255, 255, 0.72);
  }
  #site-header .nav-links a:hover {
    color: #ffffff;
  }
  #site-header #mobile-menu-toggle {
    border-color: rgba(255, 255, 255, 0.22);
    color: #ffffff;
  }
  /* Scrolled: leichte Transluzenz + Elevation als Scroll-Hinweis ueber hellem Content. */
  #site-header.scrolled {
    background: rgba(22, 26, 32, 0.92);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.32);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
</style>

<div id="header-scroll-sentinel" aria-hidden="true"></div>
<header id="site-header" class="sticky top-0 z-40">
  <div class="container flex min-h-[72px] items-center justify-between gap-6">

    <!-- Logo: helle Marken-Variante, fuer den durchgehend dunklen Header gebaut (transparenter PNG-Hintergrund) -->
    <a href="/" class="logo-lockup flex shrink-0 items-center no-underline" aria-label="HSB Hexagon Säurebau Startseite">
      <img
        src="/brand/hsb-boden-logo-dark.png"
        alt="HSB Hexagon Säurebau GmbH"
        class="h-11 w-auto object-contain"
        width="60"
        height="44"
        fetchpriority="high"
        decoding="async"
      />
    </a>

    <!-- Rechter Cluster: Navigation, Sprache und CTA bilden eine bewusste Gruppe -->
    <div class="flex min-w-0 items-center gap-3 xl:gap-4">
      <nav class="nav-links hidden min-w-0 flex-wrap items-center gap-x-3 gap-y-0 text-xs font-bold lg:flex xl:gap-4 xl:text-sm" aria-label="Hauptnavigation">
        {navigation.filter(n => n.href !== "/kontakt/").map((item) => (
          <a class="inline-flex min-h-11 items-center whitespace-nowrap transition-colors" href={item.href}>{item.label}</a>
        ))}
      </nav>

      <!-- Bedienbarer Sprachwähler mit crawlbaren Links zu allen sechs Sprachen -->
      <div class="relative hidden lg:block" data-language-picker>
        <button
          type="button"
          class="flex min-h-11 items-center gap-1 rounded border border-white/20 bg-white/5 px-3 text-xs font-bold text-white transition-colors hover:border-white/40 focus:outline-none focus:ring-2 focus:ring-hsb-red"
          id="language-toggle"
          aria-label={`${lang.toUpperCase()} – Sprache wählen`}
          aria-expanded="false"
          aria-controls="language-menu"
        >
          <span class="uppercase">{lang}</span>
          <svg class="size-3 text-white/60" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2.5 4.5l3.5 3.5 3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
        <div id="language-menu" hidden class="absolute right-0 top-full mt-1.5 w-40 rounded border border-white/10 bg-[#161a20] p-1.5 shadow-2xl z-50">
          {languages.map((item) => (
            <a
              href={item.href}
              class={`flex min-h-11 items-center justify-between rounded px-2 py-1.5 text-sm font-medium transition-colors ${item.code === lang ? "bg-hsb-red text-white font-bold" : "text-white/80 hover:bg-white/10 hover:text-white"}`}
              aria-current={item.code === lang ? "page" : undefined}
            >
              <span>{item.label}</span>
              <span class="text-xs text-white/75">{item.title}</span>
            </a>
          ))}
        </div>
      </div>

      <a
        class="hidden items-center gap-2 whitespace-nowrap text-sm font-bold text-white/72 transition-colors hover:text-white 2xl:flex"
        href={`tel:${phoneHref}`}
        aria-label={`HSB anrufen: ${site.phone}`}
      >
        <svg width="15" height="15" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M12.7 10.3c-.3-.5-2-1.4-2.4-1.6-.4-.2-.7-.2-1 .2-.2.3-.8 1-.9 1.1-.2.1-.4.1-.6 0-1-.4-2.6-1.7-3.5-3-.2-.3-.1-.5 0-.7.2-.2.5-.5.6-.7.2-.3.2-.6 0-.9-.2-.4-1-2.1-1.4-2.5C3.1 2 2.9 2 2.6 2c-.3 0-.8.2-1.1.6C1 3.2.4 4 .4 5.3c0 1.4.8 2.8 1 3 .2.3 2.1 3.3 5.1 4.7 3 1.3 3 .9 3.5.8.5-.1 1.7-.7 1.9-1.4.3-.7.3-1.2.1-1.4h-.3z" fill="currentColor"/>
        </svg>
        <span>{site.phone}</span>
      </a>

      <div class="hidden lg:block">
        <a class="button-primary text-xs xl:text-sm px-4 py-2.5 xl:px-5 xl:py-3" href="/kontakt/">Projekt besprechen</a>
      </div>

      <button
        id="mobile-menu-toggle"
        class="flex size-11 items-center justify-center rounded border lg:hidden"
        aria-label="Navigation öffnen"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-menu" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M2 4.5h14M2 9h14M2 13.5h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
        <svg id="icon-close" class="hidden" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M3 3l12 12M15 3L3 15" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile menu -->
  <nav
    id="mobile-menu"
    class="hidden max-h-[calc(100dvh-72px)] overflow-y-auto border-t border-white/10 bg-hsb-black"
    aria-label="Mobile Navigation"
  >
    <div class="container py-4">
      {navigation.map((item) => (
        <a
          href={item.href}
          class="flex items-center border-b border-white/10 py-3.5 text-sm font-bold text-white/78 last:border-0 hover:text-white"
        >
          {item.label}
        </a>
      ))}
      <a
        href={`tel:${phoneHref}`}
        class="mt-4 flex items-center justify-center gap-2 rounded border border-white/20 px-4 py-3 text-sm font-bold text-white hover:border-white/40"
        aria-label={`HSB anrufen: ${site.phone}`}
      >
        <span>Direkt anrufen</span>
        <span class="text-white/65">{site.phone}</span>
      </a>
      <div class="pt-4">
        <a class="button-primary w-full text-center" href="/kontakt/">Projekt besprechen</a>
      </div>

      <!-- Sprachen im mobilen Menü -->
      <div class="mt-5 border-t border-white/10 pt-4" aria-label="Sprachauswahl mobil">
        <p class="mb-2.5 text-xs font-black uppercase tracking-wider text-white/50">Sprache / Language</p>
        <div class="grid grid-cols-3 gap-2">
          {languages.map((item) => (
            <a
              href={item.href}
              class={`flex items-center justify-center rounded border px-2 py-2 text-xs font-bold transition-colors ${item.code === lang ? "border-hsb-red bg-hsb-red text-white" : "border-white/15 text-white/80 hover:border-white/30 hover:text-white"}`}
              aria-current={item.code === lang ? "page" : undefined}
            >
              {item.label} · {item.title}
            </a>
          ))}
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById("site-header") as HTMLElement | null;
  const sentinel = document.getElementById("header-scroll-sentinel");
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconMenu = document.getElementById("icon-menu");
  const iconClose = document.getElementById("icon-close");
  let pastHeaderSentinel = false;

  function syncHeaderState() {
    if (!header) return;
    const menuOpen = toggle?.getAttribute("aria-expanded") === "true";
    header.classList.toggle("scrolled", pastHeaderSentinel || menuOpen);
  }

  if (header && sentinel && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        pastHeaderSentinel = !entry.isIntersecting;
        syncHeaderState();
      },
      { rootMargin: "-72px 0px 0px 0px", threshold: 0 },
    );
    observer.observe(sentinel);
  }
  syncHeaderState();

  const languageToggle = document.getElementById("language-toggle");
  const languageMenu = document.getElementById("language-menu");
  const languagePicker = document.querySelector("[data-language-picker]");

  function closeLanguages() {
    if (languageMenu) languageMenu.hidden = true;
    languageToggle?.setAttribute("aria-expanded", "false");
  }

  languageToggle?.addEventListener("click", () => {
    if (!languageMenu) return;
    languageMenu.hidden = !languageMenu.hidden;
    languageToggle.setAttribute("aria-expanded", String(!languageMenu.hidden));
  });
  document.addEventListener("click", (event) => {
    if (!languagePicker?.contains(event.target as Node)) closeLanguages();
  });
  languagePicker?.addEventListener("focusout", (event) => {
    if (!languagePicker.contains((event as FocusEvent).relatedTarget as Node | null)) closeLanguages();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    if (languageMenu && !languageMenu.hidden) {
      closeLanguages();
      languageToggle?.focus();
    }
    if (toggle?.getAttribute("aria-expanded") === "true") {
      toggle.click();
      toggle.focus();
    }
  });

  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
    iconMenu?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
    syncHeaderState();
  });
</script>
