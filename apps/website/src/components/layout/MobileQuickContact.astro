---
import { site } from "../../data/site";
import type { Lang } from "../../lib/i18n";
import { toTelephoneHref } from "../../lib/phone";

interface Props {
  lang?: Lang;
}

const { lang = "de" } = Astro.props;
const phoneHref = toTelephoneHref(site.phone);

const labels: Record<Lang, { call: string; request: string }> = {
  de: { call: "Anrufen", request: "Projekt anfragen" },
  en: { call: "Call us", request: "Request quote" },
  tr: { call: "Ara", request: "Teklif Alın" },
  nl: { call: "Bellen", request: "Offerte aanvragen" },
  pl: { call: "Zadzwoń", request: "Zapytaj o wycenę" },
  fr: { call: "Appeler", request: "Demander un devis" },
};

const text = labels[lang] ?? labels.de;
const contactHref = lang === "de" ? "/kontakt/" : `/${lang}/`;
---

<aside
  class="fixed inset-x-0 bottom-0 z-40 flex items-center justify-between gap-2 border-t border-white/15 bg-hsb-black/95 px-3 py-2 shadow-[0_-4px_20px_rgba(0,0,0,0.45)] backdrop-blur-md md:hidden"
  aria-label="Schnellkontakt"
>
  <a
    href={phoneHref}
    class="flex flex-1 items-center justify-center gap-2 rounded border border-white/20 bg-white/5 py-2.5 text-xs font-bold text-white transition-colors hover:bg-white/10 active:scale-[0.98]"
    data-astro-prefetch="false"
  >
    <svg class="size-4 shrink-0 text-hsb-red" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
    </svg>
    <span>{text.call}</span>
  </a>

  <a
    href={contactHref}
    class="flex flex-1 items-center justify-center gap-2 rounded bg-hsb-red py-2.5 text-xs font-bold text-white shadow-sm transition-colors hover:bg-red-700 active:scale-[0.98]"
  >
    <span>{text.request}</span>
    <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="5" y1="12" x2="19" y2="12"/>
      <polyline points="12 5 19 12 12 19"/>
    </svg>
  </a>
</aside>
