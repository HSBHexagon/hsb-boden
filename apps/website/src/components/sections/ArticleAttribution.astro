---
import { site } from "../../data/site";

interface Props {
  readTime: string;
  category: string;
  lang?: "de" | "es";
}

const { readTime, category, lang } = Astro.props;
const isSpanish = lang ? lang === "es" : Astro.url.pathname.startsWith("/es/");
---

<div class="flex flex-wrap items-center gap-3 border-y border-hsb-mist/60 py-4 text-sm text-hsb-steel">
  <span class="font-medium text-hsb-ink">HSB Hexagon Säurebau GmbH</span>
  <span aria-hidden="true">·</span>
  <span>{isSpanish ? `Artículo técnico ${category}` : `Fachbeitrag ${category}`}</span>
  <span aria-hidden="true">·</span>
  <span>{isSpanish ? `${readTime} de lectura` : `${readTime} Lesezeit`}</span>
  <span aria-hidden="true">·</span>
  <a href={isSpanish ? `${site.domain}/es/referencias/` : `${site.domain}/referenzen/`} class="underline decoration-hsb-steel/40 underline-offset-4 hover:decoration-hsb-ink">
    {isSpanish ? "Ver proyectos de referencia" : "Referenzprojekte ansehen"}
  </a>
</div>
