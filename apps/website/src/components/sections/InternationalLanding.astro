---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { homeAlternates, landing } from "../../lib/i18n";
import { toTelephoneHref } from "../../lib/phone";
import { site } from "../../data/site";
import LeadForm from "../forms/LeadForm.astro";
import { internationalHeroMedia } from "../../data/internationalLandings";

interface Props {
  lang: keyof typeof landing;
}

const { lang } = Astro.props;
const t = landing[lang];
const path = `/${lang}/`;
const phoneHref = toTelephoneHref(site.phone);
const heroMedia = internationalHeroMedia[lang];
---

<BaseLayout title={t.meta.seoTitle} description={t.meta.description} path={path} lang={lang} alternates={homeAlternates}>
  <section class="section bg-hsb-mist">
    <div class="container grid items-center gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-12">
      <div>
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 class="h1 mt-4">{t.hero.h1}</h1>
      <p class="lead mt-6 max-w-3xl">{t.hero.text}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="button-primary" href="#contact">{t.hero.ctaContact}</a>
        <a class="button-secondary-dark" href="/">{t.hero.ctaGerman}</a>
      </div>
      </div>
      <figure class="overflow-hidden rounded-[4px] border border-hsb-line bg-white">
        <img src="/media/hsb/projekte/verlegung-keramik-640.webp" alt={heroMedia.alt} width="640" height="480" loading="eager" fetchpriority="high" decoding="async" class="aspect-[4/3] w-full object-cover" />
        <figcaption class="border-t border-hsb-line px-4 py-3 text-xs font-bold leading-5 text-hsb-steel">{heroMedia.caption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="h2">{t.systems.title}</h2>
      <p class="lead mt-4 max-w-3xl">{t.systems.intro}</p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {t.systems.items.map((item) => (
          <article class="surface p-6">
            <h3 class="h3">{item.title}</h3>
            <p class="mt-3 text-sm leading-6 text-hsb-steel">{item.text}</p>
          </article>
        ))}
      </div>
      <p class="mt-6 text-sm text-hsb-steel">{t.germanNote}</p>
    </div>
  </section>

  <section class="section bg-hsb-mist">
    <div class="container grid gap-10 lg:grid-cols-2 lg:items-start">
      <div>
        <h2 class="h2">{t.industries.title}</h2>
        <p class="lead mt-4">{t.industries.intro}</p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {t.industries.items.map((item) => (
            <li class="rounded border border-hsb-line bg-white px-4 py-3 text-sm font-bold text-hsb-black">{item}</li>
          ))}
        </ul>
      </div>
      <div class="rounded-[4px] bg-hsb-black p-8 text-white lg:p-10">
        <p class="eyebrow-light">{t.reference.title}</p>
        <h2 class="h2 mt-4 text-white">{t.reference.name}</h2>
        <p class="mt-5 text-sm leading-7 text-white/70">{t.reference.text}</p>
      </div>
    </div>
  </section>

  <section id="proceso" class="section">
    <div class="container">
      <h2 class="h2">{t.process.title}</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {t.process.steps.map((step, index) => (
          <article class="surface p-6">
            <p class="text-xs font-black uppercase tracking-wide text-hsb-red">0{index + 1}</p>
            <h3 class="h3 mt-2">{step.title}</h3>
            <p class="mt-3 text-sm leading-6 text-hsb-steel">{step.text}</p>
          </article>
        ))}
      </div>
      {lang === "es" && (
        <div class="mt-10 flex flex-wrap gap-3 border-t border-hsb-line pt-8">
          <a class="button-primary" href="/es/servicios/">Ver todos los servicios</a>
          <a class="button-secondary-dark" href="/es/sectores/">Sectores industriales</a>
          <a class="button-secondary-dark" href="/es/conocimiento/">Artículos técnicos y análisis de juntas</a>
          <a class="button-secondary-dark" href="/es/referencias/">Proyectos de referencia</a>
          <a class="button-secondary-dark" href="/es/analisis-cargas/">Comprobador de cargas</a>
          <a class="button-secondary-dark" href="/es/calculadora-paradas/">Calculadora de paradas</a>
        </div>
      )}
    </div>
  </section>

  <section id="contact" tabindex="-1" class="section bg-hsb-black text-white">
    <div class="container max-w-4xl">
      <h2 class="h2 text-white">{t.contact.title}</h2>
      <p class="mt-4 max-w-2xl text-base leading-7 text-white/70">{t.contact.text}</p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <a class="rounded border border-white/15 p-6 no-underline transition-colors hover:border-white/40" href={phoneHref}>
          <p class="text-xs font-black uppercase tracking-wide text-white/60">{t.contact.phoneLabel}</p>
          <p class="mt-2 text-lg font-black text-white">{site.phone}</p>
        </a>
        <a class="rounded border border-white/15 p-6 no-underline transition-colors hover:border-white/40" href={`mailto:${site.email}`}>
          <p class="text-xs font-black uppercase tracking-wide text-white/60">{t.contact.emailLabel}</p>
          <p class="mt-2 text-lg font-black text-white">{site.email}</p>
        </a>
      </div>
      <p class="mt-6 text-sm text-white/60">{t.contact.languagesNote}</p>
      {lang === "es" && (
        <div class="mt-8 text-hsb-black">
          <LeadForm lang="es" />
        </div>
      )}
    </div>
  </section>
</BaseLayout>
