---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Abmeldung anfordern | HSB Hexagon Säurebau"
  description="Fordern Sie die Abmeldung von weiteren E-Mails der HSB Hexagon Säurebau GmbH an."
  path="/abmelden/"
  robots="noindex, nofollow"
>
  <section class="section bg-hsb-mist min-h-[60vh] flex items-center">
    <div class="container max-w-2xl text-center py-16">
      <p class="eyebrow text-hsb-stone uppercase tracking-widest text-xs font-bold">Widerspruch &amp; Abmeldung</p>
      <h1 class="h1 mt-3 text-3xl font-extrabold text-hsb-charcoal">Abmeldung anfordern</h1>
      <p class="lead mt-6 text-base text-gray-600 leading-relaxed">
        Wenn Sie keine weiteren E-Mails wünschen, antworten Sie auf unsere Nachricht mit dem Betreff
        „Abmelden“ oder senden Sie uns Ihre Abmeldung über den folgenden Link.
      </p>
      <p id="unsubscribe-address" class="mt-4 text-sm text-gray-600"></p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a id="unsubscribe-mail" class="button-primary px-6 py-3 text-sm font-semibold rounded"
          href="mailto:j-cherino@hsb-boden.com?subject=Abmelden">Abmeldung per E-Mail senden</a>
        <a class="button-secondary-dark px-6 py-3 text-sm font-semibold rounded" href="/">Zur Startseite</a>
      </div>
      <p class="text-sm text-gray-600 mt-6 leading-relaxed">
        Bitte verwenden Sie die angeschriebene E-Mail-Adresse. Der Link öffnet Ihr E-Mail-Programm;
        senden Sie dort die vorbereitete Nachricht ab. Allein der Aufruf dieser Seite bewirkt noch keine Sperre.
      </p>
      <p class="text-sm text-gray-600 mt-4">
        Ohne E-Mail-Programm: Schreiben Sie mit dem Betreff „Abmelden“ an
        <a href="mailto:j-cherino@hsb-boden.com?subject=Abmelden" class="underline">j-cherino@hsb-boden.com</a>.
      </p>
    </div>
  </section>
  <script is:inline>
    const params = new URLSearchParams(window.location.search);
    const email = (params.get('email') || '').trim();
    const link = document.getElementById('unsubscribe-mail');
    const display = document.getElementById('unsubscribe-address');
    if (email.length <= 254 && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) && link && display) {
      display.textContent = 'Angeschriebene Adresse: ' + email;
      const body = 'Bitte melden Sie die E-Mail-Adresse ' + email + ' von weiteren E-Mails ab.\nVielen Dank.';
      link.setAttribute('href', 'mailto:j-cherino@hsb-boden.com?subject=Abmelden&body=' + encodeURIComponent(body));
    }
  </script>
</BaseLayout>
