---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site";
---
<BaseLayout title="Abmeldung anfordern | HSB Hexagon Säurebau" description="Kontakt zur Abmeldung von E-Mail-Kontaktaufnahmen durch HSB Hexagon Säurebau GmbH." path="/abmelden/" robots="noindex, nofollow">
  <section class="section bg-hsb-mist min-h-[60vh]">
    <div class="container max-w-2xl py-12">
      <p class="eyebrow">Widerspruch und Abmeldung</p>
      <h1 class="h1 mt-3">Abmeldung anfordern</h1>
      <p class="lead mt-6">Teilen Sie uns über den folgenden E-Mail-Link mit, welche Adresse wir für weitere Kontaktaufnahmen sperren sollen. Erst die eingegangene Nachricht ermöglicht uns die Bearbeitung.</p>
      <p class="mt-4 text-hsb-steel">Der Aufruf dieser Seite allein trägt keine Sperre in unser System ein.</p>
      <a id="unsubscribe-mail" class="button-primary mt-8" href={`mailto:${site.email}?subject=Abmeldung%20von%20E-Mail-Kontaktaufnahmen`}>Abmeldung per E-Mail anfordern</a>
      <p class="mt-4 text-sm text-hsb-steel">Alternativ schreiben Sie an <a class="underline" href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
  </section>
  <script>
    const email = new URLSearchParams(window.location.search).get("email");
    const link = document.getElementById("unsubscribe-mail") as HTMLAnchorElement | null;
    if (link && email && email.length <= 254 && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      const body = `Bitte sperren Sie die Adresse ${email} für weitere E-Mail-Kontaktaufnahmen.`;
      link.href += `&body=${encodeURIComponent(body)}`;
    }
  </script>
</BaseLayout>
