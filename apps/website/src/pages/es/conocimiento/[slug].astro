---
import SpanishContactSection from "../../../components/forms/SpanishContactSection.astro";
import PageHero from "../../../components/sections/PageHero.astro";
import ArticleAttribution from "../../../components/sections/ArticleAttribution.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { spanishArticles } from "../../../data/es/articles";
import { spanishIndustries } from "../../../data/es/industries";
import { spanishServices } from "../../../data/es/services";
import { spanishAlternates, toSpanishPath } from "../../../lib/spanishPaths";
import { buildArticleJsonLd, buildBreadcrumbJsonLd } from "../../../lib/schema";

export const prerender = true;

export function getStaticPaths() {
  return spanishArticles.map((article) => ({
    params: { slug: article.localizedSlug },
    props: { article },
  }));
}

const { article } = Astro.props;
const path = `/es/conocimiento/${article.localizedSlug}/`;
const titleLower = article.title.replace(/[?!.]+$/, "").toLowerCase();
const relatedServices = spanishServices.filter((service) =>
  article.relatedServices.includes(service.slug),
);
const relatedIndustries = spanishIndustries.filter((industry) =>
  article.relatedIndustries.includes(industry.slug),
);
---

<BaseLayout
  lang="es"
  alternates={spanishAlternates(path)}
  title={article.seoTitle}
  description={article.description}
  path={path}
  jsonLd={[
    buildBreadcrumbJsonLd([
      { name: "Inicio", path: toSpanishPath("/") },
      { name: "Conocimiento", path: toSpanishPath("/wissen/") },
      { name: article.title, path },
    ]),
    buildArticleJsonLd({
      headline: article.h1,
      description: article.description,
      path,
      language: "es",
    }),
  ]}
>
  <PageHero
    lang="es"
    eyebrow={article.category}
    title={article.h1}
    text={article.description}
    ctaLabel="Solicitar inspección técnica"
    ctaHref="#contact"
  />
  <div class="container max-w-3xl">
    <ArticleAttribution readTime={article.readTime} category={article.category} lang="es" />
  </div>
  <article class="section">
    <div class="container max-w-3xl">
      <p class="lead">{article.intro}</p>
      <div class="prose prose-lg mt-10 max-w-none">
        {article.sections.map((section, index) => (
          <section>
            <h2>{section.title}</h2>
            <p>
              {section.body
                ? section.body
                : index === 0
                  ? `Este apartado encuadra técnicamente ${titleLower} y explica qué requisitos resultan realmente decisivos en áreas críticas de producción.`
                  : index === article.sections.length - 1
                    ? `Para los responsables de planta, lo determinante es qué elección de sistema ofrece durabilidad comprobada, qué riesgos se evitan y cómo se integra la intervención en la operativa.`
                    : `En el ámbito «${section.title}» se analizan los criterios técnicos que deciden sobre la durabilidad, la facilidad de limpieza y la viabilidad de la rehabilitación.`}
            </p>
          </section>
        ))}
      </div>
    </div>
  </article>
  {(relatedServices.length > 0 || relatedIndustries.length > 0) && (
    <section class="section-tight bg-hsb-mist">
      <div class="container">
        <p class="eyebrow">Contenido relacionado</p>
        <h2 class="h2 mt-3">Servicios y sectores relacionados</h2>
        <div class="mt-8 grid-auto">
          {relatedServices.map((service) => (
            <a class="surface p-6 no-underline" href={`/es/servicios/${service.localizedSlug}/`}>
              <p class="eyebrow">Servicio</p>
              <h3 class="h3 mt-2">{service.title}</h3>
              <p class="mt-3 text-sm leading-7 text-hsb-steel">{service.problem}</p>
            </a>
          ))}
          {relatedIndustries.map((industry) => (
            <a class="surface p-6 no-underline" href={`/es/sectores/${industry.localizedSlug}/`}>
              <p class="eyebrow">Sector</p>
              <h3 class="h3 mt-2">{industry.title}</h3>
              <p class="mt-3 text-sm leading-7 text-hsb-steel">{industry.searchIntent}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
  <SpanishContactSection />
</BaseLayout>
