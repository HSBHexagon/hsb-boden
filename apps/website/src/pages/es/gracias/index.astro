---
import BaseLayout from "../../../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout title="Consulta recibida | HSB" description="Hemos recibido su consulta. El equipo de HSB revisará los datos de su proyecto de pavimentación industrial." path="/es/gracias/" lang="es" robots="noindex, follow">
  <section class="section bg-hsb-mist">
    <div class="container max-w-3xl">
      <p class="eyebrow">HSB Hexagon Säurebau</p>
      <h1 class="h1 mt-4">Hemos recibido su consulta</h1>
      <p class="lead mt-6">Gracias por los datos de su proyecto. Revisaremos la información para coordinar los siguientes pasos.</p>
      <a class="button-primary mt-8" href="/es/">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>
