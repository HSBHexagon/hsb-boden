---
import ReferenceCard from "../../../components/references/ReferenceCard.astro";
import ReferenceMap from "../../../components/references/ReferenceMap.astro";
import SpanishContactSection from "../../../components/forms/SpanishContactSection.astro";
import PageHero from "../../../components/sections/PageHero.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { projectSrcset } from "../../../lib/responsiveImage";
import { getPublicReferences, getSupplementalClientLocations } from "../../../lib/content";
import { spanishAlternates, toSpanishPath } from "../../../lib/spanishPaths";
import { buildBreadcrumbJsonLd } from "../../../lib/schema";

const references = getPublicReferences();
const supplementalClients = getSupplementalClientLocations();
const path = "/es/referencias/";
const title = "Referencias en pavimentos industriales y antiácidos | HSB";
const description =
  "Referencias de pavimentos industriales cerámicos, protección antiácida, drenaje y rehabilitación en producción alimentaria, lácteas, cervecerías e industria química.";
---

<BaseLayout
  lang="es"
  alternates={spanishAlternates(path)}
  title={title}
  description={description}
  path={path}
  jsonLd={[
    buildBreadcrumbJsonLd([
      { name: "Inicio", path: toSpanishPath("/") },
      { name: "Referencias", path },
    ]),
  ]}
>
  <PageHero
    lang="es"
    eyebrow="Referencias"
    title="Pavimentos industriales ejecutados en áreas críticas de producción"
    text="Nuestras referencias muestran qué cargas, sistemas y sectores conoce Hexagon Säurebau, descritos de forma concreta según el reto técnico, el sistema elegido y el resultado en planta."
    ctaLabel="Solicitar evaluación"
    ctaHref="#contact"
    image={{
      src: "/media/hsb/projekte/halle-doppelrinne-keramik.webp",
      alt: "Nave de producción con dos canaletas de drenaje en pavimento cerámico hexagonal",
    }}
  />

  <section class="section-tight border-b border-hsb-line bg-hsb-mist">
    <div class="container">
      <div class="mb-8 max-w-3xl">
        <p class="eyebrow">Superficies ejecutadas</p>
        <h2 class="h2 mt-4">Superficies reales de obra en lugar de imágenes genéricas</h2>
        <p class="lead mt-4">
          Las fotografías muestran superficies, encuentros de canaletas y detalles constructivos del entorno de trabajo de HSB. Representan la calidad de ejecución técnica.
        </p>
      </div>
      <div class="grid gap-5 lg:grid-cols-[1.25fr_0.75fr]">
        <figure class="flex flex-col overflow-hidden rounded-[4px] border border-hsb-line bg-white">
          <div class="aspect-[16/10] overflow-hidden bg-hsb-black lg:aspect-auto lg:flex-1">
            <img
              src="/media/hsb/current/referenzflaeche-1.webp"
              alt="Pavimento industrial cerámico con canaleta de drenaje ejecutado por Hexagon Säurebau"
              class="h-full w-full object-cover object-center transition-transform duration-500 hover:scale-[1.015]"
              loading="lazy"
              width="554"
              height="361"
            />
          </div>
          <figcaption class="grid gap-2 px-5 py-4 text-sm leading-6 text-hsb-steel">
            <span class="text-xs font-black uppercase tracking-[0.14em] text-hsb-red">Cerámica y canaleta de drenaje</span>
            La pendiente, el borde de la canaleta y el despiece cerámico deben proyectarse de forma conjunta.
          </figcaption>
        </figure>
        <div class="grid gap-5">
          {[
            {
              src: "/media/hsb/current/referenzflaeche-2.webp",
              alt: "Revestimiento cerámico higiénico para producción alimentaria",
              label: "Revestimiento cerámico higiénico",
              text: "Geometría superficial y trazado de juntas para áreas con limpieza intensiva.",
            },
            {
              src: "/media/hsb/current/referenzflaeche-3.webp",
              alt: "Superficie resistente a los ácidos en entorno industrial ejecutada por Hexagon Säurebau",
              label: "Protección antiácida y detalles de encuentro",
              text: "La ejecución de los encuentros decide si una superficie mantiene su resistencia a largo plazo.",
            },
          ].map((img) => (
            <figure class="grid overflow-hidden rounded-[4px] border border-hsb-line bg-white sm:grid-cols-[190px_1fr] lg:grid-cols-1">
              <div class="aspect-[4/3] overflow-hidden sm:aspect-auto lg:aspect-[4/3]">
                <img
                  src={img.src}
                  srcset={projectSrcset(img.src)}
                  sizes="(min-width: 1024px) 380px, (min-width: 640px) 190px, calc(100vw - 32px)"
                  alt={img.alt}
                  class="h-full w-full object-cover object-center transition-transform duration-500 hover:scale-[1.015]"
                  loading="lazy"
                  width="562"
                  height="369"
                />
              </div>
              <figcaption class="grid gap-2 px-5 py-4 text-sm leading-6 text-hsb-steel">
                <span class="text-xs font-black uppercase tracking-[0.14em] text-hsb-red">{img.label}</span>
                {img.text}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="mb-8 max-w-3xl">
        <p class="eyebrow">Más impresiones de obra</p>
        <h2 class="h2 mt-4">Naves, canaletas y encuentros del trabajo diario</h2>
      </div>
      <div class="grid gap-5 sm:grid-cols-3">
        {[
          {
            src: "/media/hsb/projekte/keramik-halle-rinnen.webp",
            alt: "Nave de producción luminosa con dos canaletas de drenaje paralelas en pavimento cerámico hexagonal",
            label: "Doble canaleta en nave",
            text: "Dos líneas de canaletas paralelas para pendientes claras en grandes superficies.",
          },
          {
            src: "/media/hsb/projekte/saeulen-anschluss-keramik.webp",
            alt: "Encuentro limpio en pilar de nave sobre pavimento cerámico hexagonal",
            label: "Encuentro en pilar",
            text: "Remates perimetrales precisos en pilares y elementos empotrados.",
          },
          {
            src: "/media/hsb/projekte/halle-in-ausfuehrung.webp",
            alt: "Nave industrial durante la colocación del pavimento cerámico hexagonal",
            label: "Nave en ejecución",
            text: "Colocación en gran superficie con planificación clara por fases de obra.",
          },
        ].map((img) => (
          <figure class="overflow-hidden rounded-[4px] border border-hsb-line bg-white">
            <div class="aspect-[4/3] overflow-hidden">
              <img
                src={img.src}
                srcset={projectSrcset(img.src)}
                sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, calc(100vw - 32px)"
                alt={img.alt}
                class="h-full w-full object-cover object-center transition-transform duration-500 hover:scale-[1.015]"
                loading="lazy"
                width="562"
                height="421"
              />
            </div>
            <figcaption class="grid gap-2 px-5 py-4 text-sm leading-6 text-hsb-steel">
              <span class="text-xs font-black uppercase tracking-[0.14em] text-hsb-red">{img.label}</span>
              {img.text}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid gap-8 lg:grid-cols-[0.92fr_1.08fr] lg:items-start">
      <ReferenceMap references={references} clients={supplementalClients} lang="es" />
      <div class="grid gap-4">
        {references.map((reference) => (
          <ReferenceCard reference={reference} lang="es" />
        ))}
      </div>
    </div>
  </section>
  <SpanishContactSection />
</BaseLayout>
