---
import HomepageFAQSection from "../components/sections/HomepageFAQSection.astro";
import LogoCloud from "../components/sections/LogoCloud.astro";
import CTASection from "../components/sections/CTASection.astro";
import RepairInquirySection from "../components/forms/RepairInquirySection.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { homeAlternates } from "../lib/i18n";
import { buildFaqJsonLd, buildLocalBusinessJsonLd, buildWebSiteJsonLd } from "../lib/schema";
import { homepageFaqs } from "../data/homepageFaqs";
import { projectSrcset } from "../lib/responsiveImage";

const industryTiles = [
  { title: "Lebensmittelindustrie", href: "/branchen/lebensmittelindustrie/", desc: "Hygienisch, porenarm, hochdruckfest und auditfähig", image: "/media/hsb/projekte/keramik-halle-rinnen.webp", alt: "Keramischer Industrieboden mit zwei Entwässerungsrinnen in einer Produktionshalle" },
  { title: "Molkerei & Käserei", href: "/branchen/molkerei/", desc: "Schutz vor Milchsäure, Feuchte und Heißdampf", image: "/media/hsb/projekte/brauerei-tanks-keramik.webp", alt: "Sechskant-Keramikboden zwischen Edelstahltanks" },
  { title: "Brauerei & Getränke", href: "/branchen/brauerei-getraenkeindustrie/", desc: "Laugenbeständig, rutschhemmend R11–R13, für rollende Lasten", image: "/media/hsb/projekte/halle-doppelrinne-keramik.webp", alt: "Keramikboden mit Doppelrinne und Gefälle in einer Abfüllhalle" },
  { title: "Chemieindustrie", href: "/branchen/chemieindustrie/", desc: "Säureschutz, WHG-Abdichtung und Lösemittelbeständigkeit", image: "/media/hsb/projekte/chemie-anlage-keramik.webp", alt: "Keramischer Industrieboden mit Rinne vor einer Prozessanlage" },
  { title: "Pharmaindustrie", href: "/branchen/pharmaindustrie/", desc: "Fugenarme Flächen mit Hohlkehlen für GMP-Bereiche", image: "/media/hsb/projekte/pharma-halle-keramik.webp", alt: "Heller Keramikboden mit Entwässerungsrinnen in einer Produktionshalle" },
  { title: "Großküchen & Backstuben", href: "/branchen/backwarenproduktion-grosskueche/", desc: "Beständig gegen Fettsäuren und Hitze, trittsicher", image: "/media/hsb/projekte/verlegung-keramik.webp", alt: "Sechskantfliesen während der Verlegung mit Bodenabläufen" },
];

const serviceLinks = [
  { title: "Industrieboden-Säureschutz", href: "/leistungen/industrieboden-saeureschutz/", desc: "Beständig gegen Säuren, Laugen und CIP-Reinigung" },
  { title: "Keramische Industrieböden", href: "/leistungen/keramische-industrieboeden/", desc: "Rüttelkeramik und Sechskantfliesen für hohe Lasten" },
  { title: "PU-Beton Industrieboden", href: "/leistungen/pu-beton-industrieboden/", desc: "Fugenlose Beläge für Thermoschock-Bereiche" },
  { title: "Epoxidharz-Beschichtung", href: "/leistungen/epoxidharz-bodenbeschichtung/", desc: "Versiegelungen für Lager und Montage" },
  { title: "Entwässerungssysteme", href: "/leistungen/entwaesserung-industrieboden/", desc: "Edelstahlrinnen mit Flansch, Wannen und Gefälle" },
  { title: "WHG-Abdichtung nach § 62", href: "/leistungen/whg-abdichtung-industrieboden/", desc: "Auffangräume und Fugen nach AwSV/WHG" },
  { title: "Sanierung im laufenden Betrieb", href: "/leistungen/bodensanierung-laufender-betrieb/", desc: "Wochenend-Montage und getaktete Bauabschnitte" },
  { title: "Reparatur & Instandsetzung", href: "/leistungen/boden-reparatur-instandsetzung/", desc: "Fugen, Kanten und Schadstellen gezielt reparieren" },
];

const proofCards = [
  { image: "/media/hsb/projekte/hexagon-rinne-detail.webp", alt: "Edelstahl-Entwässerungsrinne, eingefasst in Sechskant-Keramikfliesen", tag: "Entwässerung", title: "Rinne und Belag als ein Bauteil", text: "Die Rinne wird mit Flansch in den Belag eingebunden – der Punkt, an dem Böden am häufigsten undicht werden." },
  { image: "/media/hsb/projekte/saeulen-anschluss-keramik.webp", alt: "Anschluss von Sechskantfliesen an einen Stützenfuß mit Rinne", tag: "Detailausbildung", title: "Anschlüsse an Stützen und Sockeln", text: "Stützenfüße, Sockel und Dehnungsfugen werden einzeln geplant und sauber angearbeitet." },
  { image: "/media/hsb/projekte/beschichtete-halle.webp", alt: "Frisch beschichteter, glänzender Industrieboden in einer Halle", tag: "Beschichtung", title: "Fugenlose Flächen", text: "PU-Beton und Epoxidharz nach Belastungsprofil – mit festen Aushärtezeiten für kurze Sperrfenster." },
];
---

<BaseLayout
  title={site.defaultTitle}
  description={site.defaultDescription}
  path="/"
  jsonLd={[buildWebSiteJsonLd(), buildLocalBusinessJsonLd(), buildFaqJsonLd(homepageFaqs)]}
  alternates={homeAlternates}
>

  <!-- BLOCK 1: HERO -->
  <section class="relative overflow-hidden border-b-4 border-hsb-red bg-hsb-black text-white">
    <div class="container relative z-10 pb-0 pt-14 lg:pt-20">
      <div class="grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-stretch">

        <!-- Left: Copy & Core Message -->
        <div class="pb-12 lg:pb-16">
          <p class="eyebrow-light mb-6 flex items-center gap-2.5">
            <svg width="11" height="12.7" viewBox="0 0 26 30" fill="none" aria-hidden="true" class="shrink-0">
              <path d="M12.9904 0L25.9808 7.5V22.5L12.9904 30L0 22.5V7.5L12.9904 0Z" fill="#cb0000" />
            </svg>
            Industrieböden & Säureschutz · Ausführung nach WHG § 62
          </p>
          <h1 class="hero-h1 max-w-[18ch]">
            Spezialisierte Industrieböden für Lebensmittel-, Pharma- und <span class="text-hsb-red-light">Chemieproduktion</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-8 text-white/70">
            Planung und Ausführung aus einer Hand – in Deutschland und europaweit. <span class="font-bold text-white/95">Sanierung im laufenden Betrieb:</span> in Bauabschnitten, an Wochenenden und in Schichtfenstern.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a class="button-primary" href="#reparaturanfrage" data-open-repair-modal>Analyse vor Ort anfragen</a>
            <a class="button-secondary" href="/referenzen/">Referenzen ansehen</a>
          </div>
        </div>

        <!-- Right: Visual Proof & Key Segments -->
        <div class="grid self-stretch pb-10 lg:pb-16">
          <div class="group relative min-h-[340px] overflow-hidden rounded-[4px] border border-white/10 bg-black lg:min-h-[440px]">
            <img
              src="/media/hsb/projekte/produktionsanlage-keramik-1024.webp"
              srcset="/media/hsb/projekte/produktionsanlage-keramik-640.webp 640w, /media/hsb/projekte/produktionsanlage-keramik-1024.webp 1024w, /media/hsb/projekte/produktionsanlage-keramik.webp 1600w"
              sizes="(min-width: 1024px) 46vw, 100vw"
              alt="Keramischer Industrieboden mit Sechskantfliesen und Entwässerungsrinne vor einer Produktionsanlage"
              class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
              fetchpriority="high"
              loading="eager"
              decoding="async"
              width="1024"
              height="768"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/55 via-40% to-transparent to-75%"></div>
            <div class="relative z-10 flex h-full flex-col justify-end p-6 lg:p-8">
              <div class="eyebrow-light mb-2 flex items-center gap-2">
                <span class="size-1 bg-hsb-red"></span>
                <span>Aus unseren Projekten</span>
              </div>
              <h2 class="max-w-md text-xl font-black leading-tight text-white lg:text-2xl">
                Keramik, Entwässerung und Gefälle aus einem System.
              </h2>
              <p class="mt-2 max-w-md text-sm leading-6 text-white/80">
                Böden in Lebensmittelbetrieben müssen Säure, Reinigungsdruck und Audits dauerhaft bestehen.
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- LOGO CLOUD: Kompakter Trust-Bar -->
  <LogoCloud compact={true} />

  <!-- BLOCK 2: BRANCHEN (FOTO-KACHELN) & LEISTUNGEN -->
  <section class="border-b border-hsb-line bg-white py-12 lg:py-16">
    <div class="container">
      <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-3xl">
          <p class="eyebrow mb-3">Branchen</p>
          <h2 class="h2">Industrieböden nach Belastungsprofil</h2>
          <p class="lead mt-3">
            Jede Produktion belastet den Boden anders. Belag, Fuge, Gefälle, Entwässerung und chemischer Schutz werden deshalb als ein System geplant.
          </p>
        </div>
        <a href="/branchen/" class="whitespace-nowrap text-sm font-bold text-hsb-red hover:underline">Alle Branchen →</a>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {industryTiles.map((b) => (
          <a href={b.href} class="group relative flex min-h-[176px] items-end overflow-hidden rounded-[4px] bg-hsb-black no-underline sm:min-h-[220px]">
            <img
              src={b.image}
              srcset={projectSrcset(b.image)}
              sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
              alt={b.alt}
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              decoding="async"
              width="640"
              height="480"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 via-45% to-black/5"></div>
            <div class="relative z-10 w-full p-5">
              <h3 class="flex items-center justify-between gap-3 text-lg font-black leading-tight text-white">
                <span>{b.title}</span>
                <span class="text-hsb-red-light transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </h3>
              <p class="mt-1.5 text-sm leading-5 text-white/80">{b.desc}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-12 grid gap-8 border-t border-hsb-line pt-10 lg:grid-cols-[0.8fr_1.6fr] lg:gap-12">
        <div>
          <p class="eyebrow mb-3">Leistungen</p>
          <h2 class="text-2xl font-black leading-tight text-hsb-black lg:text-3xl">Bodensysteme und Gewerke</h2>
          <p class="mt-3 text-base leading-7 text-hsb-steel">
            Vom keramischen Belag bis zur Rinne: alle Gewerke, die über die Haltbarkeit eines Produktionsbodens entscheiden.
          </p>
          <div class="mt-6 rounded-[4px] border border-hsb-line bg-[#fbfcfd] p-4">
            <p class="mb-2.5 text-sm font-bold text-hsb-black">Häufige Schwachstellen aus Vor-Ort-Analysen</p>
            <ul class="grid gap-1.5 text-sm text-hsb-steel">
              {[
                "Thermoschock bei Heißreinigung",
                "Säureangriff auf Zementfugen",
                "Stehendes Wasser bei weniger als 1,5 % Gefälle",
                "Flanschabriss an Entwässerungsrinnen",
              ].map((item) => (
                <li class="flex items-center gap-2"><span class="size-1.5 shrink-0 rounded-full bg-hsb-red"></span>{item}</li>
              ))}
            </ul>
          </div>
        </div>

        <div>
          <ul class="grid gap-x-8 sm:grid-cols-2">
            {serviceLinks.map((s) => (
              <li class="border-b border-hsb-line">
                <a href={s.href} class="group flex items-start justify-between gap-3 py-3.5 no-underline">
                  <span>
                    <span class="block text-[0.9375rem] font-bold text-hsb-black transition-colors group-hover:text-hsb-red">{s.title}</span>
                    <span class="mt-0.5 block text-sm leading-5 text-hsb-steel">{s.desc}</span>
                  </span>
                  <span class="mt-0.5 text-hsb-steel transition-all group-hover:translate-x-1 group-hover:text-hsb-red" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
          <div class="mt-5 flex flex-wrap items-center gap-3 text-sm font-bold text-hsb-steel">
            <a href="/leistungen/" class="text-hsb-red hover:underline">Alle Leistungen →</a>
            <span class="text-hsb-line" aria-hidden="true">|</span>
            <span>Für Planer:</span>
            <a href="/beanspruchungs-check/" class="rounded border border-hsb-line bg-white px-2.5 py-1 text-hsb-black transition-colors hover:border-hsb-red hover:text-hsb-red">Beanspruchungs-Check</a>
            <a href="/planer/" class="rounded border border-hsb-line bg-white px-2.5 py-1 text-hsb-black transition-colors hover:border-hsb-red hover:text-hsb-red">LV-Texte & Planerportal</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOCK 3: VISUELLER NACHWEIS & REFERENZEN -->
  <section class="border-b border-hsb-line bg-white py-12 lg:py-16">
    <div class="container">
      <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <p class="eyebrow mb-3 flex items-center gap-2">
            <span class="size-1.5 bg-hsb-red"></span>
            <span>Ausführung im Detail</span>
          </p>
          <h2 class="h2">Wo Industrieböden halten – oder versagen</h2>
          <p class="lead mt-3">Keine Katalogbilder: Die Fotos zeigen Flächen und Details aus unseren Projekten.</p>
        </div>
        <a class="button-secondary-dark whitespace-nowrap self-start sm:self-auto" href="/referenzen/">
          Alle Referenzen & Karte ansehen →
        </a>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {proofCards.map((c) => (
          <article class="group overflow-hidden rounded-[4px] border border-hsb-line bg-white">
            <div class="aspect-[4/3] overflow-hidden bg-hsb-mist">
              <img
                src={c.image}
                srcset={projectSrcset(c.image)}
                sizes="(min-width: 768px) 33vw, 100vw"
                alt={c.alt}
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
                decoding="async"
                width="640"
                height="480"
              />
            </div>
            <div class="p-5">
              <p class="text-[0.6875rem] font-black uppercase tracking-[0.16em] text-hsb-red">{c.tag}</p>
              <h3 class="mt-1.5 text-lg font-black leading-tight text-hsb-black">{c.title}</h3>
              <p class="mt-2 text-sm leading-6 text-hsb-steel">{c.text}</p>
            </div>
          </article>
        ))}
      </div>

      <!-- Herstellerangaben als Planungsgrundlage (kein Partnerschafts-Claim) -->
      <p class="mt-8 rounded-[4px] border border-hsb-line bg-[#fbfcfd] px-5 py-4 text-sm leading-6 text-hsb-steel">
        <span class="font-bold text-hsb-black">Planungsgrundlage:</span>{" "}
        Die Systemauslegung stützt sich auf technische Unterlagen der Hersteller, etwa von Argelith und Zahna für Sechskantkeramik.
      </p>
    </div>
  </section>

  <!-- BLOCK 4: PROJEKTABLAUF -->
  <section class="border-b border-hsb-line bg-[#f8f9fb] py-12 lg:py-16" id="projektablauf">
    <div class="container">
      <div class="mb-10 max-w-2xl">
        <p class="eyebrow mb-3">Planung & Realisierung</p>
        <h2 class="h2">In vier Schritten zum belastbaren Boden</h2>
        <p class="lead mt-3">Jede Entscheidung beginnt mit der Analyse vor Ort – nicht mit dem Katalog.</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ["01", "Analyse vor Ort", "Untergrund, Schadensbild, Säure- und Reinigungschemie, Nassbelastung, Gefälle und Rinnenführung werden direkt in der Halle aufgenommen."],
          ["02", "Systemauslegung", "Keramik, PU-Beton, Epoxidharz, WHG-Abdichtung und Entwässerung werden nach Säure-, Hygiene- und Lastprofil bewertet."],
          ["03", "Sanierungsfenster planen", "Bauabschnitte, Sperrzeiten und Wiederinbetriebnahme werden mit der Produktionsplanung abgestimmt – inklusive Wochenend- und Schichtmontage."],
          ["04", "Dokumentation & Abnahme", "Gefälle, Rinnenanschlüsse, Fugen und Detailpunkte werden dokumentiert: als Nachweis für Hygieneaudits und WHG-Behörden."],
        ].map(([number, title, text]) => (
          <article class="flex flex-col justify-between rounded-[4px] border border-hsb-line bg-white p-5 shadow-sm">
            <div>
              <div class="mb-3 flex items-center gap-2">
                <span class="font-mono text-[0.6875rem] font-black tracking-[0.2em] text-hsb-red">SCHRITT</span>
                <span class="text-2xl font-black text-hsb-black tabular-nums">{number}</span>
              </div>
              <h3 class="text-base font-bold text-hsb-black">{title}</h3>
              <p class="mt-2 text-sm leading-6 text-hsb-steel">{text}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a class="button-secondary-dark" href="/projektablauf/">Projektablauf im Detail</a>
        <a class="button-primary" href="#reparaturanfrage" data-open-repair-modal>Projekt anfragen</a>
      </div>
    </div>
  </section>

  <!-- BLOCK 5: UNTERNEHMEN & TEAM -->
  <section class="border-b border-hsb-line bg-white py-12 lg:py-16" id="ueber-uns">
    <div class="container">
      <div class="mb-10 grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-12">
        <div>
          <p class="eyebrow mb-3">Unternehmen & Team</p>
          <h2 class="h2">Fachbetrieb mit eigenem, festangestelltem Team</h2>
          <p class="lead mt-4">
            HSB baut Industrieböden, Säureschutz und keramische Bodensysteme für produktionskritische Bereiche. Ausgeführt wird mit eigenem, festangestelltem Personal – ohne wechselnde Subunternehmer. Das Team ist eingespielt, mehrsprachig und auf diese Branchen spezialisiert.
          </p>
        </div>
        <figure class="overflow-hidden rounded-[4px] border border-hsb-line bg-hsb-mist">
          <img
            src="/media/hsb/projekte/halle-in-ausfuehrung.webp"
            srcset={projectSrcset("/media/hsb/projekte/halle-in-ausfuehrung.webp")}
            sizes="(min-width: 1024px) 520px, 100vw"
            alt="Produktionshalle mit neu verlegtem Sechskant-Keramikboden während der Ausführung"
            class="aspect-[16/10] h-full w-full object-cover"
            loading="lazy"
            decoding="async"
            width="640"
            height="400"
          />
          <figcaption class="border-t border-hsb-line bg-white px-4 py-2.5 text-xs font-bold text-hsb-steel">Halle in Ausführung: neuer Keramikbelag, Anschlüsse an Stützen und Tore.</figcaption>
        </figure>
      </div>

      <dl class="grid gap-px overflow-hidden rounded-[4px] border border-hsb-line bg-hsb-line sm:grid-cols-2 lg:grid-cols-4">
        {[
          ["Eigenes Fachpersonal", "Festangestelltes, eingespieltes Team – keine wechselnden Subunternehmer in der Ausführung."],
          ["Jahrzehnte Erfahrung", "Mitarbeiter mit bis zu rund 30 Jahren Berufserfahrung; Sechskantfliesen-Technik seit über 40 Jahren bewährt."],
          ["Mehrsprachig & mobil", "Bundesweit und europaweit einsetzbar, branchenspezialisiert und in der Baustellenpraxis eingespielt."],
          ["Qualifiziert & tarifgebunden", "Tarifgebunden über SOKA-BAU, Erste-Hilfe-geschult, sicherheitszertifiziert (VCA/SCC-bezogene Standards)."],
        ].map(([t, d]) => (
          <div class="bg-white p-5 lg:p-6">
            <dt class="text-[0.72rem] font-black uppercase tracking-[0.16em] text-hsb-red">{t}</dt>
            <dd class="mt-2 text-sm leading-6 text-hsb-steel">{d}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- BLOCK 6: CONVERSION-TERMINAL (Anker für #reparaturanfrage & #kontaktformular) -->
  <div id="kontaktformular" class="scroll-mt-24" aria-hidden="true"></div>
  <RepairInquirySection />

  <!-- BLOCK 7: FAQ & ABSCHLUSS -->
  <HomepageFAQSection />

  <CTASection />

</BaseLayout>
