---
import CTASection from "../../components/sections/CTASection.astro";
import PageHero from "../../components/sections/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getJobs } from "../../data/jobs";
import { buildBreadcrumbJsonLd } from "../../lib/schema";

const jobs = getJobs();
const path = "/karriere/";
---

<BaseLayout title="Karriere bei Hexagon Säurebau | Industrieboden-Projekte" description="Jetzt bewerben: Fliesenleger, Bauhelfer und Projektleitung für Keramik-Industrieböden und Säureschutzsysteme. HSB Hexagon – Ihr Arbeitgeber in der Industrie." path={path} jsonLd={[buildBreadcrumbJsonLd([{ name: "Start", path: "/" }, { name: "Karriere", path }])]}>
  <PageHero eyebrow="Karriere" title="Karriere bei Hexagon Säurebau" text="HSB braucht Verstärkung – für technisch anspruchsvolle Industrieprojekte." />
  <section class="section">
    <div class="container grid-auto">
      {jobs.map((job) => (
        <article class="surface p-6">
          <h2 class="h3">{job.title}</h2>
          <p class="mt-3 text-sm leading-7 text-hsb-steel">{job.shortDescription}</p>
          <a class="mt-5 inline-block text-sm font-black text-hsb-red" href={`/karriere/${job.slug}/`}>Stelle ansehen</a>
        </article>
      ))}
    </div>
  </section>
  <CTASection title="Team für anspruchsvolle Industrieprojekte" text="Sie wollen an besonderen Projekten arbeiten? Wir freuen uns auf Ihre Kontaktaufnahme." />
</BaseLayout>
