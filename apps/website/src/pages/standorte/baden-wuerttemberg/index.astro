---
// src/pages/standorte/baden-wuerttemberg/index.astro
import CTASection from "../../../components/sections/CTASection.astro";
import PageHero from "../../../components/sections/PageHero.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { buildBreadcrumbJsonLd, buildRegionalServiceJsonLd } from "../../../lib/schema";
import RegionalDecisionGuide from "../../../components/sections/RegionalDecisionGuide.astro";
---

<BaseLayout
  title="Industrieboden Baden-Württemberg | Böden & Säureschutz"
  description="Industrieboden Baden-Württemberg: Keramik, Fugenprofile und Entwässerung nach Radlast, Medien und Betriebsablauf auswählen."
  path="/standorte/baden-wuerttemberg/"
  jsonLd={[buildRegionalServiceJsonLd("Baden-Württemberg", "/standorte/baden-wuerttemberg/"), buildBreadcrumbJsonLd([{ name: "Start", path: "/" }, { name: "Einsatzgebiet Baden-Württemberg", path: "/standorte/baden-wuerttemberg/" }])]}
>
  <PageHero
    eyebrow="Region Baden-Württemberg"
    title="Industrieboden-Spezialist in Baden-Württemberg"
    text="Technische Auslegung und Ausführung von Industrieböden für Betriebe in Baden-Württemberg. Welche Lösung passt, hängt von den tatsächlichen Belastungen ab."
  />

  <RegionalDecisionGuide slug="baden-wuerttemberg" />

  <CTASection
    title="Projekt in Baden-Württemberg anfragen"
    text="Kontaktieren Sie uns für eine technische Ersteinschätzung zu Ihrem Industriebodenprojekt in Baden-Württemberg."
  />

</BaseLayout>
