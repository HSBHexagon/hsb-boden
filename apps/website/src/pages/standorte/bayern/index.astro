---
import CTASection from "../../../components/sections/CTASection.astro";
import PageHero from "../../../components/sections/PageHero.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { buildBreadcrumbJsonLd, buildRegionalServiceJsonLd } from "../../../lib/schema";
import RegionalDecisionGuide from "../../../components/sections/RegionalDecisionGuide.astro";
---

<BaseLayout
  title="Industrieboden Bayern | Böden & Säureschutz München"
  description="Industrieboden Bayern: Abfüllung, Gefälle, Rinnen, Reinigungstemperaturen und Keramik oder PU-Beton für die technische Planung vergleichen."
  path="/standorte/bayern/"
  jsonLd={[buildRegionalServiceJsonLd("Bayern", "/standorte/bayern/"), buildBreadcrumbJsonLd([{ name: "Start", path: "/" }, { name: "Einsatzgebiet Bayern", path: "/standorte/bayern/" }])]}
>
  <PageHero
    eyebrow="Region Bayern"
    title="Industrieboden-Spezialist in Bayern"
    text="Technische Auslegung und Ausführung von Industrieböden für Betriebe in Bayern. Welche Lösung passt, hängt von den tatsächlichen Belastungen ab."
  />

  <RegionalDecisionGuide slug="bayern" />

  <CTASection
    title="Projekt in Bayern anfragen"
    text="Kontaktieren Sie uns für eine technische Ersteinschätzung zu Ihrem Industriebodenprojekt in Bayern."
  />

</BaseLayout>
