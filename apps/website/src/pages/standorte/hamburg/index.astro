---
import CTASection from "../../../components/sections/CTASection.astro";
import PageHero from "../../../components/sections/PageHero.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { buildBreadcrumbJsonLd, buildRegionalServiceJsonLd } from "../../../lib/schema";
import RegionalDecisionGuide from "../../../components/sections/RegionalDecisionGuide.astro";
---

<BaseLayout
  title="Industrieboden Hamburg | Keramische Böden & Säureschutz Nord"
  description="Industrieboden Hamburg: Lasten, Übergänge, Entwässerung und mögliche Anforderungen an Auffangflächen im Betrieb einordnen."
  path="/standorte/hamburg/"
  jsonLd={[buildRegionalServiceJsonLd("Hamburg und Norddeutschland", "/standorte/hamburg/"), buildBreadcrumbJsonLd([{ name: "Start", path: "/" }, { name: "Einsatzgebiet Hamburg und Norddeutschland", path: "/standorte/hamburg/" }])]}
>
  <PageHero
    eyebrow="Region Hamburg & Nord"
    title="Industrieboden-Spezialist in Norddeutschland"
    text="Technische Auslegung und Ausführung von Industrieböden für Betriebe in Hamburg und Norddeutschland. Welche Lösung passt, hängt von den tatsächlichen Belastungen ab."
  />

  <RegionalDecisionGuide slug="hamburg" />

  <CTASection
    title="Projekt in Norddeutschland anfragen"
    text="Kontaktieren Sie uns für eine technische Ersteinschätzung zu Ihrem Industriebodenprojekt in Hamburg oder Norddeutschland."
  />

</BaseLayout>
