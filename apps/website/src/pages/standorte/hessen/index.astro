---
import CTASection from "../../../components/sections/CTASection.astro";
import PageHero from "../../../components/sections/PageHero.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { buildBreadcrumbJsonLd, buildRegionalServiceJsonLd } from "../../../lib/schema";
import RegionalDecisionGuide from "../../../components/sections/RegionalDecisionGuide.astro";
---

<BaseLayout
  title="Industrieboden Hessen | Böden & Säureschutz"
  description="Industrieboden Hessen: Reinigungsvalidierung, chemische Beständigkeit und Dokumentation für Produktions- und Hygienebereiche planen."
  path="/standorte/hessen/"
  jsonLd={[buildRegionalServiceJsonLd("Hessen", "/standorte/hessen/"), buildBreadcrumbJsonLd([{ name: "Start", path: "/" }, { name: "Einsatzgebiet Hessen", path: "/standorte/hessen/" }])]}
>
  <PageHero
    eyebrow="Region Hessen"
    title="Industrieboden-Spezialist in Hessen"
    text="Technische Auslegung und Ausführung von Industrieböden für Betriebe in Hessen. Welche Lösung passt, hängt von den tatsächlichen Belastungen ab."
  />

  <RegionalDecisionGuide slug="hessen" />

  <CTASection
    title="Projekt in Hessen anfragen"
    text="Kontaktieren Sie uns für eine technische Ersteinschätzung zu Ihrem Industriebodenprojekt in Hessen."
  />

</BaseLayout>
