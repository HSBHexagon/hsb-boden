---
import CTASection from "../../../components/sections/CTASection.astro";
import PageHero from "../../../components/sections/PageHero.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { buildBreadcrumbJsonLd, buildRegionalServiceJsonLd } from "../../../lib/schema";
import RegionalDecisionGuide from "../../../components/sections/RegionalDecisionGuide.astro";
---

<BaseLayout
  title="Industrieboden Niedersachsen | Böden & Säureschutz"
  description="Industrieboden Niedersachsen: Feuchte, Milchsäure, Rinnenanschlüsse und Sanierungsfenster in Lebensmittelbetrieben fachlich bewerten."
  path="/standorte/niedersachsen/"
  jsonLd={[buildRegionalServiceJsonLd("Niedersachsen", "/standorte/niedersachsen/"), buildBreadcrumbJsonLd([{ name: "Start", path: "/" }, { name: "Einsatzgebiet Niedersachsen", path: "/standorte/niedersachsen/" }])]}
>
  <PageHero
    eyebrow="Region Niedersachsen"
    title="Industrieboden-Spezialist in Niedersachsen"
    text="Technische Auslegung und Ausführung von Industrieböden für Betriebe in Niedersachsen. Welche Lösung passt, hängt von den tatsächlichen Belastungen ab."
  />

  <RegionalDecisionGuide slug="niedersachsen" />

  <CTASection
    title="Projekt in Niedersachsen anfragen"
    text="Kontaktieren Sie uns für eine technische Ersteinschätzung zu Ihrem Industriebodenprojekt in Niedersachsen."
  />

</BaseLayout>
