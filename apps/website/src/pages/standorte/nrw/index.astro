---
import CTASection from "../../../components/sections/CTASection.astro";
import PageHero from "../../../components/sections/PageHero.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { buildBreadcrumbJsonLd, buildRegionalServiceJsonLd } from "../../../lib/schema";
import RegionalDecisionGuide from "../../../components/sections/RegionalDecisionGuide.astro";
---

<BaseLayout
  title="Industrieboden NRW | Böden & Säureschutz"
  description="Industrieboden NRW: Säureschutz, WHG-Flächen und Sanierung anhand von Medienliste, Fugen und Betriebsfenstern technisch bewerten."
  path="/standorte/nrw/"
  jsonLd={[buildRegionalServiceJsonLd("Nordrhein-Westfalen", "/standorte/nrw/"), buildBreadcrumbJsonLd([{ name: "Start", path: "/" }, { name: "Einsatzgebiet Nordrhein-Westfalen", path: "/standorte/nrw/" }])]}
>
  <PageHero
    eyebrow="Region NRW"
    title="Industrieboden-Spezialist in Nordrhein-Westfalen"
    text="Technische Auslegung und Ausführung von Industrieböden für Betriebe in Nordrhein-Westfalen. Welche Lösung passt, hängt von den tatsächlichen Belastungen ab."
  />

  <RegionalDecisionGuide slug="nrw" />

  <CTASection
    title="Projekt in NRW anfragen"
    text="Kontaktieren Sie uns für eine technische Ersteinschätzung zu Ihrem Industriebodenprojekt in Nordrhein-Westfalen."
  />

</BaseLayout>
