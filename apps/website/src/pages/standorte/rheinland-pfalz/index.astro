---
import CTASection from "../../../components/sections/CTASection.astro";
import PageHero from "../../../components/sections/PageHero.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { buildBreadcrumbJsonLd, buildRegionalServiceJsonLd } from "../../../lib/schema";
import RegionalDecisionGuide from "../../../components/sections/RegionalDecisionGuide.astro";
---

<BaseLayout
  title="Industrieboden Rheinland-Pfalz | Böden & Säureschutz"
  description="Industrieboden Rheinland-Pfalz: Getränkeproduktion, Nasszonen und Reparaturen anhand von Medien, Gefälle und Betriebsfenstern planen."
  path="/standorte/rheinland-pfalz/"
  jsonLd={[buildRegionalServiceJsonLd("Rheinland-Pfalz", "/standorte/rheinland-pfalz/"), buildBreadcrumbJsonLd([{ name: "Start", path: "/" }, { name: "Einsatzgebiet Rheinland-Pfalz", path: "/standorte/rheinland-pfalz/" }])]}
>
  <PageHero
    eyebrow="Region Rheinland-Pfalz"
    title="Industrieboden-Spezialist in Rheinland-Pfalz"
    text="Technische Auslegung und Ausführung von Industrieböden für Betriebe in Rheinland-Pfalz. Welche Lösung passt, hängt von den tatsächlichen Belastungen ab."
  />

  <RegionalDecisionGuide slug="rheinland-pfalz" />

  <CTASection
    title="Projekt in Rheinland-Pfalz anfragen"
    text="Kontaktieren Sie uns für eine technische Ersteinschätzung zu Ihrem Industriebodenprojekt in Rheinland-Pfalz."
  />

</BaseLayout>
