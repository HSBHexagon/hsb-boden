---
import CTASection from "../../../components/sections/CTASection.astro";
import PageHero from "../../../components/sections/PageHero.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Industrieboden Sachsen-Anhalt | Böden & Säureschutz"
  description="HSB Hexagon – Spezialist für keramische Industrieböden, Säureschutz & WHG-Abdichtung in Sachsen-Anhalt. Projekte in Magdeburg, Halle, Zeitz & Region."
  path="/standorte/sachsen-anhalt/"
>
  <PageHero
    eyebrow="Region Sachsen-Anhalt"
    title="Industrieboden-Spezialist in Sachsen-Anhalt"
    text="HSB Hexagon realisiert anspruchsvolle Industrieboden- und Säureschutzprojekte in Magdeburg, Halle (Saale), Dessau, Zeitz und ganz Sachsen-Anhalt."
  />

  <section class="section">
    <div class="container">
      <div class="prose max-w-3xl mx-auto">
        <h2>Keramische Industrieböden & Säureschutz in Sachsen-Anhalt</h2>
        <p>
          Als erfahrener Fachbetrieb für keramische Industrieböden, Säureschutzsysteme und WHG-konforme Abdichtungen sind wir in ganz Sachsen-Anhalt tätig. Ob Großprojekte in der Zucker- und Lebensmittelproduktion (z. B. in Zeitz), Chemieanlagen im Mitteldeutschen Chemiedreieck oder Brauereien – HSB Hexagon liefert langlebige und nachweisbar dichte Bodensysteme.
        </p>

        <h2>Unsere Leistungen in Sachsen-Anhalt</h2>
        <ul>
          <li><strong>Säureschutz & WHG-Abdichtung</strong> – zertifizierte Kombinationsbeläge und säurefeste Fugen nach § 62 WHG</li>
          <li><strong>Keramische Industrieböden</strong> – rüttelverlegte Feinsteinzeugbeläge für höchste mechanische Lasten</li>
          <li><strong>Entwässerungssysteme</strong> – Edelstahl-Kastenrinnen, Gefälleausbildung und dichte Anschlüsse</li>
          <li><strong>Dehnungsfugen & Rammschutz</strong> – schwerlasttaugliche Fugenprofile für Gabelstaplerverkehr</li>
          <li><strong>Industrieboden-Sanierung</strong> – modulare Sanierungsabschnitte im laufenden Betrieb</li>
        </ul>

        <h2>Regionale Präsenz in Sachsen-Anhalt</h2>
        <p>
          Wir betreuen Kunden in der gesamten Region Sachsen-Anhalt: Magdeburg, Halle (Saale), Dessau-Roßlau, Zeitz, Wittenberg, Stendal, Halberstadt und Bitterfeld.
        </p>
      </div>
    </div>
  </section>

  <CTASection
    title="Projekt in Sachsen-Anhalt anfragen"
    text="Kontaktieren Sie uns für eine unverbindliche Beratung zu Ihrem Industriebodenprojekt in Sachsen-Anhalt."
  />

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Hexagon Säurebau GmbH",
    "description": "Spezialist für keramische Industrieböden, Säureschutzsysteme und Entwässerung in Sachsen-Anhalt",
    "url": "https://www.hsb-boden.de",
    "areaServed": [
      {"@type": "City", "name": "Magdeburg"},
      {"@type": "City", "name": "Halle (Saale)"},
      {"@type": "City", "name": "Dessau-Roßlau"},
      {"@type": "City", "name": "Zeitz"},
      {"@type": "AdministrativeArea", "name": "Sachsen-Anhalt"}
    ],
    "sameAs": "https://www.hsb-boden.de"
  })} />
</BaseLayout>
