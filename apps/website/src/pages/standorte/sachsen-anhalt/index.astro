---
import CTASection from "../../../components/sections/CTASection.astro";
import PageHero from "../../../components/sections/PageHero.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { buildBreadcrumbJsonLd, buildRegionalServiceJsonLd } from "../../../lib/schema";
import RegionalDecisionGuide from "../../../components/sections/RegionalDecisionGuide.astro";
---

<BaseLayout
  title="Industrieboden Sachsen-Anhalt | Böden & Säureschutz"
  description="Industrieboden Sachsen-Anhalt: Bestandsaufnahme, chemische Belastung und WHG-/AwSV-relevante Abdichtungen technisch klären."
  path="/standorte/sachsen-anhalt/"
  jsonLd={[buildRegionalServiceJsonLd("Sachsen-Anhalt", "/standorte/sachsen-anhalt/"), buildBreadcrumbJsonLd([{ name: "Start", path: "/" }, { name: "Einsatzgebiet Sachsen-Anhalt", path: "/standorte/sachsen-anhalt/" }])]}
>
  <PageHero
    eyebrow="Region Sachsen-Anhalt"
    title="Industrieboden-Spezialist in Sachsen-Anhalt"
    text="Technische Auslegung und Ausführung von Industrieböden für Betriebe in Sachsen-Anhalt. Welche Lösung passt, hängt von den tatsächlichen Belastungen ab."
  />

  <RegionalDecisionGuide slug="sachsen-anhalt" />

  <CTASection
    title="Projekt in Sachsen-Anhalt anfragen"
    text="Kontaktieren Sie uns für eine technische Ersteinschätzung zu Ihrem Industriebodenprojekt in Sachsen-Anhalt."
  />

</BaseLayout>
