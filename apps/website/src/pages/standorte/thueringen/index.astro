---
import CTASection from "../../../components/sections/CTASection.astro";
import PageHero from "../../../components/sections/PageHero.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { buildBreadcrumbJsonLd, buildRegionalServiceJsonLd } from "../../../lib/schema";
import RegionalDecisionGuide from "../../../components/sections/RegionalDecisionGuide.astro";
---

<BaseLayout
  title="Industrieboden Thüringen | Böden & Säureschutz"
  description="Industrieboden Thüringen: Hygieneanschlüsse, Reparatur und Wiederinbetriebnahme abhängig von Bodenaufbau und Reinigungsanforderungen prüfen."
  path="/standorte/thueringen/"
  jsonLd={[buildRegionalServiceJsonLd("Thüringen", "/standorte/thueringen/"), buildBreadcrumbJsonLd([{ name: "Start", path: "/" }, { name: "Einsatzgebiet Thüringen", path: "/standorte/thueringen/" }])]}
>
  <PageHero
    eyebrow="Region Thüringen"
    title="Industrieboden-Spezialist in Thüringen"
    text="Technische Auslegung und Ausführung von Industrieböden für Betriebe in Thüringen. Welche Lösung passt, hängt von den tatsächlichen Belastungen ab."
  />

  <RegionalDecisionGuide slug="thueringen" />

  <CTASection
    title="Projekt in Thüringen anfragen"
    text="Kontaktieren Sie uns für eine technische Ersteinschätzung zu Ihrem Industriebodenprojekt in Thüringen."
  />

</BaseLayout>
