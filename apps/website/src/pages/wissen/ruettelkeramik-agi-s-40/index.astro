---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/sections/PageHero.astro";
import LeadFormSection from "../../../components/forms/LeadFormSection.astro";
import { buildArticleJsonLd, buildBreadcrumbJsonLd } from "../../../lib/schema";
import { spanishAlternates } from "../../../lib/spanishPaths";

export const prerender = true;

const path = "/wissen/ruettelkeramik-agi-s-40/";
const title = "Rüttelboden-Aufbau: Schichten & AGI S 40 | HSB";
const headline = "Rüttelboden-Aufbau: Schichten, Verlegung und AGI S 40";
const description = "Wie ist ein Rüttelboden aufgebaut? Untergrund, Haftbrücke, Mörtelbett, Rüttelfliesen und Fugen im Überblick – mit Planungshinweisen zu AGI S 40.";
---

<BaseLayout
  alternates={spanishAlternates(path)}
  title={title}
  description={description}
  path={path}
  jsonLd={[
    buildArticleJsonLd({ headline, description, path }),
    buildBreadcrumbJsonLd([
      { name: "Start", path: "/" },
      { name: "Wissen", path: "/wissen/" },
      { name: "Rüttelkeramik AGI S 40", path },
    ]),
  ]}
>
  <PageHero
    eyebrow="Fachnorm & Ingenieurbau"
    title={headline}
    text="Ein Rüttelboden ist ein abgestimmtes System aus Untergrund, Haftbrücke, Mörtelbett, keramischem Belag und Fugen. Dieser Leitfaden erklärt die Schichten und das Rüttelverfahren sowie die Einordnung von AGI S 40 für chemisch beständige Bodenbeläge. Die konkrete Auslegung folgt dem Belastungsprofil und den Produktnachweisen."
  />

  <section class="section border-b border-hsb-line bg-white">
    <div class="container max-w-4xl">
      <div class="prose max-w-none text-hsb-steel">
        <p>
          Sie planen einen neuen Boden oder die Sanierung einer Produktionsfläche?
          Auf der Leistungsseite <a href="/leistungen/keramische-industrieboeden/">Rüttelboden und keramische Industrieböden</a>
          finden Sie Einsatzbereiche und Entscheidungskriterien. Den Vergleich mit einem anderen System bietet unser
          <a href="/wissen/pu-beton-oder-keramischer-industrieboden/">Ratgeber zu PU-Beton und Keramik</a>.
        </p>
        <h2 class="text-2xl font-black text-hsb-black">Was regelt das Arbeitsblatt AGI S 40?</h2>
        <p>
          Das Arbeitsblatt <strong>AGI S 40</strong> mit dem Titel <em>„Chemisch beständige Bodenbeläge im Rüttelverfahren (Säureschutzbau)“</em> (Ausgabe Mai 1999) wird von der Arbeitsgemeinschaft Industriebau e. V. herausgegeben und regelt die Planung, Ausführung und Gütesicherung von keramischen Belägen im industriellen Säureschutzbau. Es richtet sich an Betriebe, in denen Bodenflächen gleichzeitig extremen chemischen Angriffen (Säuren, Laugen, Fette) und mechanischen Einwirkungen (Flurförderzeuge, dynamische Radstöße) standhalten müssen.
        </p>

        <div class="my-8 rounded border-l-4 border-hsb-red bg-hsb-mist p-6 text-hsb-black">
          <h3 class="text-lg font-bold">Der entscheidende Unterschied zur Handverlegung</h3>
          <p class="mt-2 text-sm leading-6 text-hsb-steel">
            Bei ungeeignetem Verlegeverfahren oder unzureichender Ausführung können Hohlstellen unter Fliesen entstehen. Unter harter Staplerüberrollung bricht die Fliese genau an diesen Hohlräumen. Beim <strong>maschinellen Rüttelverfahren</strong> nach AGI S 40 werden die Platten mit hochfrequenten Flächenrüttlern in das plastische Mörtelbett eingerüttelt. Die Vibration verflüssigt den Verlegemörtel kurzzeitig thixotrop: Das Verfahren kann einen hohen Bettungsgrad unterstützen; die tatsächliche Hohlstellenfreiheit muss geprüft werden. Dabei kann der Mörtel an den Fugenflanken aufsteigen.
          </p>
        </div>

        <h2 class="text-2xl font-black text-hsb-black">Technische Leistungswerte im Vergleich</h2>
        <div class="not-prose my-6 overflow-x-auto" role="region" aria-label="Leistungswerte Handverlegung und AGI S 40 im Vergleich, horizontal scrollbar" tabindex="0">
          <table class="w-full text-left text-sm border border-hsb-line">
            <thead class="bg-hsb-mist text-hsb-black">
              <tr>
                <th class="p-3 border-b border-hsb-line">Leistungsparameter</th>
                <th class="p-3 border-b border-hsb-line">Handverlegte Fliese</th>
                <th class="p-3 border-b border-hsb-line text-hsb-red font-bold">AGI S 40 Rüttelkeramik</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hsb-line text-hsb-steel">
              <tr>
                <td class="p-3 font-semibold text-hsb-black">Bettungsgrad (Vollbettung)</td>
                <td class="p-3">Ausführungsabhängig</td>
                <td class="p-3 font-bold text-hsb-black">Hoher Bettungsgrad angestrebt; zu prüfen</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-hsb-black">Druckfestigkeit System</td>
                <td class="p-3">Abhängig von Mörtel und Untergrund</td>
                <td class="p-3 font-bold text-hsb-black">Druckfestigkeit laut Herstellerdatenblatt</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-hsb-black">Temperaturbeständigkeit</td>
                <td class="p-3">Nur laut Systemfreigabe</td>
                <td class="p-3 font-bold text-hsb-black">System- und medienabhängig; Datenblatt prüfen</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-hsb-black">Punktlast (Vulkollanrollen)</td>
                <td class="p-3">Bruchgefahr bei Hohlstellen</td>
                <td class="p-3 font-bold text-hsb-black">Belastbarkeit abhängig von Bettungsgrad und Nachweis</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-hsb-black">Verfugungsmaterial</td>
                <td class="p-3">Zementär / Dispersionsfuge</td>
                <td class="p-3 font-bold text-hsb-black">2K-Epoxid- / Novolac-Harz</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2 class="text-2xl font-black text-hsb-black">Typische Einsatzbereiche in der Industrie</h2>
        <p>Rüttelkeramik nach AGI S 40 wird überall dort eingesetzt, wo ein Bodenausfall existenzbedrohend ist:</p>
        <ul class="space-y-2">
          <li><strong>Molkereien & Käsereien:</strong> Beständigkeit gegen Milchsäure, Salzlake und tägliche CIP-Reinigung mit warmen Reinigungsmedien gemäß Systemfreigabe.</li>
          <li><strong>Brauereien & Getränkeindustrie:</strong> Schutz vor Fruchtsäuren, Kohlensäure, Laugen und schweren Fassrollern.</li>
          <li><strong>Fleisch- & Feinkostbetriebe:</strong> Fett-, Blut- und Eiweißbeständigkeit bei geforderter Rutschhemmklasse nach objektspezifisch geforderter Rutschhemmung.</li>
          <li><strong>Chemie & Batterieproduktion:</strong> Säureschutz nach WHG § 62 und Beständigkeit gegen anorganische Säuren (z. B. Schwefel-, Salzsäure).</li>
        </ul>

        <h2 class="mt-10 text-2xl font-black text-hsb-black">Systemaufbau eines AGI S 40 Rüttelbodens</h2>
        <ol class="space-y-4">
          <li><strong>1. Tragfähiger Unterbeton:</strong> Kugelgestrahlt oder gefräst, mit nachgewiesener Oberflächenzugfestigkeit gemäß Projekt- und Systemvorgabe.</li>
          <li><strong>2. Haftbrücke / Dichtschicht:</strong> Reaktionsharz-Grundierung oder polymermodifizierte Kontaktschlämme.</li>
          <li><strong>3. Rüttelbettmörtel:</strong> Erdfeuchter, kunststoffvergüteter Spezialmörtel mit optimierter Sieblinie; Schichtdicke nach Objektbelastung und Herstellerangabe.</li>
          <li><strong>4. Säureschutz-Spaltklinker / Steinzeug:</strong> Hochabriebfeste, säurebeständige Platten in objektspezifisch nach Last- und Herstellerfreigabe bemessener Materialstärke.</li>
          <li><strong>5. Chemikalienbeständige Verfugung:</strong> Vollfugiger Verguss mit 2K-Epoxidharzmörtel nach AGI S 40.</li>
        </ol>

        <div class="mt-10 flex flex-wrap items-center gap-4 border-t border-hsb-line pt-8">
          <a class="button-primary" href="/leistungen/keramische-industrieboeden/">Rüttelboden für Ihr Projekt planen</a>
          <a class="button-secondary-dark" href="/beanspruchungs-check/">Belastungen im Beanspruchungs-Check prüfen</a>
        </div>
      </div>
    </div>
  </section>

  <LeadFormSection />
</BaseLayout>
