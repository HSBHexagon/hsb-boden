{
  "name": "hsb-boden",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check --js-only",
    "test:run": "vitest run",
    "deploy": "npm run deploy:preview",
    "deploy:preview": "npm run build && wrangler pages deploy dist --project-name hsb-boden --branch preview --commit-dirty=true",
    "deploy:production": "echo 'BLOCKED: Production deploys run only via .github/workflows/deploy-production.yml (workflow_dispatch, approval-gated).' && exit 1",
    "deploy:dry-run": "npm run build && wrangler pages functions build functions --outdir node_modules/.cache/functions-check",
    "check:sitemap": "node scripts/check-sitemap-consistency.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/outfit": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "serialize-javascript": "^7.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@types/serialize-javascript": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^20.0.0",
    "playwright": "^1.62.1",
    "vite": "8.2.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.118.0"
  }
}
