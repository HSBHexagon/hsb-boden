---
import CTASection from "../../../components/sections/CTASection.astro";
import PageHero from "../../../components/sections/PageHero.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Industrieboden Hessen | Böden & Säureschutz"
  description="HSB Hexagon – Spezialist für keramische Industrieböden, Säureschutz & Entwässerung in Hessen. Projekte in Frankfurt, Kassel, Darmstadt & Region."
  path="/standorte/hessen/"
>
  <PageHero
    eyebrow="Region Hessen"
    title="Industrieboden-Spezialist in Hessen"
    text="HSB Hexagon realisiert anspruchsvolle Industriebodenprojekte in Frankfurt am Main, Wiesbaden, Kassel, Darmstadt, Fulda und ganz Hessen."
  />

  <section class="section">
    <div class="container">
      <div class="prose max-w-3xl mx-auto">
        <h2>Keramische Industrieböden & Säureschutz in Hessen</h2>
        <p>
          Als erfahrener Fachbetrieb für keramische Industrieböden und Säureschutzsysteme sind wir in ganz Hessen tätig. Ob Pharma- und Chemiestandorte im Rhein-Main-Gebiet, Lebensmittelbetriebe in Nord- und Mittelhessen oder Logistikzentren – HSB Hexagon liefert dauerhaft belastbare und WHG-konforme Bodensysteme.
        </p>

        <h2>Unsere Leistungen in Hessen</h2>
        <ul>
          <li><strong>Keramische Industrieböden</strong> – rutschhemmend, hygienekonform und chemikalienbeständig</li>
          <li><strong>Säureschutz & WHG-Abdichtung</strong> – für Chemie-, Pharma- und Industrieanlagen</li>
          <li><strong>PU-Beton</strong> – für Hygienebereiche mit Heißwasser- und Thermoschockbelastung</li>
          <li><strong>Entwässerungssysteme</strong> – Edelstahlrinnen, Gefälleestrich und dichte Anbindung</li>
          <li><strong>Industrieboden-Sanierung</strong> – schnelle Ausführung in produktionsfreien Zeitfenstern</li>
        </ul>

        <h2>Regionale Präsenz in Hessen</h2>
        <p>
          Wir betreuen Industrieprojekte in ganz Hessen: Frankfurt am Main, Wiesbaden, Kassel, Darmstadt, Offenbach, Hanau, Gießen, Fulda, Marburg und Umgebung. Schnelle Reaktionszeiten und fundierte Fachberatung vor Ort.
        </p>
      </div>
    </div>
  </section>

  <CTASection
    title="Projekt in Hessen anfragen"
    text="Kontaktieren Sie uns für eine unverbindliche Beratung zu Ihrem Industriebodenprojekt in Hessen."
  />

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Hexagon Säurebau GmbH",
    "description": "Spezialist für keramische Industrieböden, Säureschutzsysteme und Entwässerung in Hessen",
    "url": "https://www.hsb-boden.de",
    "areaServed": [
      {"@type": "City", "name": "Frankfurt am Main"},
      {"@type": "City", "name": "Wiesbaden"},
      {"@type": "City", "name": "Kassel"},
      {"@type": "City", "name": "Darmstadt"},
      {"@type": "City", "name": "Fulda"},
      {"@type": "AdministrativeArea", "name": "Hessen"}
    ],
    "sameAs": "https://www.hsb-boden.de"
  })} />
</BaseLayout>
